10 DEFINT A-Z:FALSE=0:TRUE=NOT FALSE
100 DEF FNHEXN$(A,N)=STRING$(N-LEN(HEX$(A)),"0")+HEX$(A)
110 DEF FNMEMW(I!)=I!+(I!>32767)*65536!:DEF FNABSW!(I.)=I.-(I.<0)*65536!
120 DEF FNHIBT(I)=INT(FNABSW!(I)/256):DEF FNLOBT(I)=FNABSW!(I)-FNHIBT(I)*256
130 DEF FNEOPF(CO1, CO2)= CO1=&HFFFF AND CO2=&HFFFF
140 DEF FNBTV(REC$,OFS)=ASC(MID$(REC$,OFS,1)):DEF FNWDV(REC$,OFS)=CVI(MID$(REC$,OFS,2))
150 DEF FNRCN(L,R)=INT(FNABSW!(L)/R):DEF FNOFS(L,R)=FNABSW!(L) MOD R
160 DEF FNMIN(A,B)=-(A>B)*B-(B>=A)*A:DEF FNMAX(A,B)=-(A<B)*B-(A>=B)*A
170 DEF FNRNG(A)=A>=ASC(" ")AND A<=ASC("~"):DEF FNCHAR$(A)=CHR$(A*(-FNRNG(A))-46*(NOT FNRNG(A)))
200 MJR=0:MNR=1:REM RTS version number
210 SGNON$="P-CODE TO 8080 TRANSLATOR"
220 TRF=0
230 DIM NOPT[3]
240 DIM TLOD[50]:TLDI=0
1000 PRINT SGNON$:DBG=2:OPL=3
1010 PRINT USING"Optimisation level = #. ";OPL;:INPUT"P-code file name (.PCD is assumed)";SFBN$
1020 INPUT"Want P-codes listed";PLF$
1030 PLN$=SFBN$+".$$$":PLN=2:OPEN"O",PLN,PLN$:CLOSE PLN:KILL PLN$:EXF$=SFBN$+".COM":EXF=1:OPEN"O",EXF,EXF$:CLOSE EXF:KILL EXF$
1040 PXN$=SFBN$+".PAX":PXN=1:OPEN"O",PXN,PXN$:CLOSE PXN:KILL PXN$:PAL$=SFBN$+".LSA":PAL=2:OPEN"O",PAL,PAL$:CLOSE PAL:KILL PAL$:PFN$=SFBN$+".PCD":PFN=3:OPEN"I",PFN,PFN$:CLOSE PFN
1050 GOSUB 21000
1060 RTSFN$="PRUN.LIB":RLN=128:GOSUB 22000
1070 IF OPL>2 THEN GOSUB 20000
1080 GOSUB 23000:GOSUB 26000
1090 IF LEFT$(PLF$,1)="Y"OR LEFT$(PLF$,1)="y"THEN GOSUB 27000
1100 IF DBG>0 THEN PRINT"Stack starts at ";FNHEXN$(SBM,4)
1110 NAME PLN$ AS EXF$
1120 IF DBG=0 THEN KILL PXN$
1130 GOSUB 28000
1140 END
10000 OPEN"R",#PFN,PFN$,4:FIELD#PFN,2 AS CO1$,2 AS CO2$:PC.PI=0
10010 PQ1=0:PQ2=0:PCO2=0
10020 GOSUB 12300:PRINT CHR$(13)PC.PI;:WHILE NOT FNEOPF(CO1,CO2):GOSUB 11000:PC.PI=PC.PI+1:GOSUB 12300:PRINT CHR$(13)PC.PI;:WEND
10030 CLOSE#PFN:PRINT
10040 RETURN
11000 IF Q1=2 AND PQ1=3 AND Q2=PQ2 AND CO2=PCO2 THEN PRINT"STO-LOD"
11010 PQ1=Q1:PQ2=Q2:PCO2=CO2:RETURN
12000 TRF=TRF+1:IF CO2<=PC.PI THEN 12100 ELSE REFRS[REF.INDX,0]=CO2:REFRS[REF.INDX,1]=AC.PI:IF DBG>0 THEN DBG$=" Fwd"+STR$(REF.INDX)+": PC"+STR$(REFRS[REF.INDX,0])
12010 REF.INDX=REF.INDX+1:RETURN

12100 GET#1,CO2+1:OUT.WORD=CVI(AC.PI$):IF DBG>0 THEN DBG$=" Bwd: PC"+STR$(CO2)+"= AC "+FNHEXN$(OUT.WORD,4)
12110 RETURN 

12200 LSET AC.PI$=MKI$(AC.PI):PUT#1,PC.PI+1:RETURN
12300 GET#3,PC.PI+1:CO1=CVI(CO1$):CO2=CVI(CO2$):Q1=CO1\256:Q2=CO1 MOD 256:RETURN
12400 IF DBG>0 THEN PRINT USING"&=#####: && ###_,######=&=&&";FNHEXN$(AC.PI,4);PC.PI;OPCODE$[Q1 MOD 16];MID$("X ",2+(Q1\16<>0),1);Q2;CO2;FNHEXN$(CO2,4);FNCHAR$(CO2\256);FNCHAR$(CO2 MOD 256);:DBG$="":OPT$="":RETURN
12410 PRINT CHR$(13);PC.PI;:RETURN
12500 IF DBG>0 THEN PRINT " "DBG$;OPT$
12510 RETURN
12600 LSET OUT.BYTE$=CHR$(OUT.BYTE):PUT#2,AC.PI-&H100+1:AC.PI=AC.PI+1:RETURN
12700 OUT.BYTE=FNLOBT(OUT.WORD):GOSUB 12600:OUT.BYTE=FNHIBT(OUT.WORD):GOTO 12600
20000 IF DBG>0 THEN PRINT"Scanning for JMP/JPC targeting LODs"
20010 OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$,2 AS CO2$:PC.PI=0
20020 GOSUB 12300:PRINT PC.PI;CHR$(13);:WHILE NOT FNEOPF(CO1,CO2):GOSUB 20080:PC.PI=PC.PI+1:GOSUB 12300:PRINT PC.PI;CHR$(13);:WEND
20030 CLOSE#3
20040 IF TLDI>0 THEN GOSUB 20200:IF DBG>0 THEN PRINT" "TLDI"targeted LODs found":IF DBG>1 THEN FOR I=0 TO TLDI-1:PRINT TLOD[I]:NEXT
20050 IF TLDI>0 THEN GOSUB 20300:IF DBG>0 THEN PRINT" "TLDI"unique targeted LODs":IF DBG>1 THEN FOR I=0 TO TLDI-1:PRINT TLOD[I]:NEXT
20060 IF DBG>0 THEN PRINT" Done scanning"
20070 RETURN
20080 IF Q1<>6 AND Q1<>7 THEN RETURN
20090 GET#3,CO2+1:TQ1=CVI(CO1$)\256:IF TQ1<>2 THEN RETURN
20100 TLOD[TLDI]=CO2:TLDI=TLDI+1:PRINT:RETURN
20200 IF DBG>0 THEN PRINT" Sorting"
20210 FOR I=TLDI-1 TO 1 STEP -1:FOR J=0 TO I-1:IF TLOD[J]>TLOD[J+1]THEN SWAP TLOD[J],TLOD[J+1]
20220 NEXT J,I
20230 RETURN
20300 IF DBG>0 THEN PRINT" Removing duplicates"
20310 J=0:FOR I=1 TO TLDI-1:IF TLOD[I]<>TLOD[J]THEN J=J+1:TLOD[J]=TLOD[I]
20320 NEXT:IF TLDI>0 THEN TLDI=J+1
20330 RETURN
21000 DIM OPCODE$[8]:RESTORE 21000:FOR I=0 TO 8:READ OPCODE$[I]:NEXT:RETURN
21010 DATA LIT,OPR,LOD,STO,CAL,INT,JMP,JPC,CSP
22000 IF DBG>0 THEN PRINT"Reading RTS table"
22010 OPEN"R",#1,RTSFN$,RLN:FIELD#1,RLN AS RCRD$:GET#1,1:TBL.ADR=CVI(MID$(RCRD$,4,2))-&H100:TBL.RCN=FNRCN(TBL.ADR,RLN):TBL.OFS=FNOFS(TBL.ADR,RLN):IF TBL.OFS<>0 THEN PRINT"RTS info should start at offset 0, but offset is"TBL.OFS:STOP
22020 IF DBG>1 THEN PRINT"RTS info on page "FNHEXN$(TBL.RCN,2)
22030 GET#1,TBL.RCN+1:VN.MJ=FNBTV(RCRD$,1):VN.MN=FNBTV(RCRD$,2):VN.BF=FNBTV(RCRD$,3):PROGB=CVI(MID$(RCRD$,5,2)):TBL.LNADR=CVI(MID$(RCRD$,7,2))-&H100:INIT.LNADR=CVI(MID$(RCRD$,9,2))-&H100
22040 IF VN.MJ<>MJR OR VN.MN<MNR THEN PRINT"Incompatible RTS version!":STOP
22050 IF DBG>1 THEN PRINT"RTS version:"VN.MJ"."VN.MN"."VN.BF:PRINT"Translated P-code starts at "FNHEXN$(PROGB,4):PRINT"RTS table is at file address "FNHEXN$(TBL.LNADR,4):PRINT"INIT is at file address "FNHEXN$(INIT.LNADR,4)
22060 GET#1,FNRCN(TBL.LNADR,RLN)+1:TABLELEN=CVI(MID$(RCRD$,1,2))
22070 DIM PRTABLE[63]:FOR I=O TO TABLELEN-1:PRTABLE[I]=FNWDV(RCRD$,3+2*I):NEXT:IF DBG>2 THEN PRINT"RTS addresses:":FOR I=0 TO TABLELEN-1:PRINT I,FNHEXN$(PRTABLE[I],4):NEXT:PRINT
22080 DIM P2R[8]:J=2*TABLELEN:FOR I=0 TO 8:P2R[I]=FNWDV(RCRD$,3+J+2*I):NEXT
22090 IF DBG>2 THEN FOR I=0 TO 8:PRINT OPCODE$[I],FNHEXN$(P2R[I],4):NEXT
22100 CLOSE#1
22110 IF DBG>0 THEN PRINT" Done reading RTS table"
22120 IF DBG>0 THEN PRINT"Copying RTS"
22130 OPEN"R",#1,RTSFN$,128:FIELD#1,128 AS SRC$:OPEN"R",#2,PLN$,128:FIELD#2,128 AS DST$
22140 N.BYTES=PROGB-&H100:N.PAGES=(N.BYTES+127)\128:IF DBG>1 THEN PRINT" Copying "N.BYTES"("HEX$(N.BYTES)") bytes = "N.PAGES" ("HEX$(N.PAGES)") pages"
22150 FOR I=1 TO N.PAGES:GET#1,I:LSET DST$=SRC$:PUT#2,I:IF DBG>1 THEN PRINT I;
22160 NEXT:IF DBG>1 THEN PRINT
22170 IF DBG>0 THEN PRINT" Done copying RTS"
22180 CLOSE #1,#2
22190 RETURN
23000 IF DBG>0 THEN PRINT"Translating"
23010 OPEN"R",#1,PXN$,2:FIELD#1,2 AS AC.PI$
23020 OPEN"R",#2,PLN$,1:FIELD#2,1 AS OUT.BYTE$:AC.PI=PROGB
23030 OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$,2 AS CO2$:PC.PI=0
23040 DIM REFRS[1000,1]:REF.INDX=0:TRF=0:TLDX=0
23050 GOSUB 12300:WHILE NOT FNEOPF(CO1,CO2):GOSUB 12200:GOSUB 12400:GOSUB 24000:GOSUB 12500:PC.PI=PC.PI+1:GOSUB 12300:WEND:IF DBG=0 THEN PRINT
23060 SBM=AC.PI:MAX.PC.PI=PC.PI
23070 N.RFRS=REF.INDX
23080 IF DBG>0 THEN PRINT"Fixing"N.RFRS"references"
23090 FOR REF.INDX=0 TO N.RFRS-1:PC.ADRS=REFRS[REF.INDX,0]:AC.PI=REFRS[REF.INDX,1]:GET#1,PC.ADRS+1:OUT.WORD=CVI(AC.PI$)
23100 IF DBG>0 THEN IF DBG>1 THEN PRINT"Forward reference: P-code address is "PC.ADRS" = "FNHEXN$(OUT.WORD,4)" @ "FNHEXN$(AC.PI,4) ELSE PRINT REF.INDX+1;CHR$(13);
23110 GOSUB 12700:NEXT
23120 CLOSE#1,#2,#3
23130 IF DBG>0 THEN PRINT" Done translating and fixing references"
23140 RETURN
24000 ON (Q1 MOD 16)+1 GOTO 24100,24200,24400,24500,24600,24730,24810,24920,25010,25100,25100,25100,25100,25100,25100,25100
24010 REM: TRANSLATE:       LIT   OPR   LOD   STO   CAL   INT   JMP   JPC   CSP   ERR...
24100 REM:LIT 0,N: LXI B,N:CALL LIT
24110 IF OPL>1 AND CO2=0 THEN 24140
24120 OUT.BYTE=&H1:GOSUB 12600:OUT.WORD=CO2:GOSUB 12700
24130 OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]]:GOTO 12700
24140 OUT.BYTE=&HAF:GOSUB 12600:FOR I=1 TO 2:OUT.BYTE=&H13:GOSUB 12600:OUT.BYTE=&H12:GOSUB 12600:NEXT
24150 NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24200 REM OPR 0,N: CALL OPR00$NN, EXCEPT FOR OPR 0,0: JMP OPR00$00
24210 IF OPL>1 AND (CO2=1 OR CO2=2 OR CO2=3)THEN 24240
24220 IF CO2=0 THEN OUT.BYTE=&HC3 ELSE OUT.BYTE=&HCD
24230 GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+CO2]:GOTO 12700
24240 GET#3,PC.PI:PCO1=CVI(CO1$):PCO2=CVI(CO2$):PQ1=PCO1\256:IF PQ1<>0 THEN 24220 ELSE IF CO2=1 THEN 24250 ELSE IF CO2=2 OR CO2=3 THEN 24270 ELSE STOP'CO2 (=OPR)  SHOULD BE 1, 2 OR 3
24250 IF PCO2=0 THEN NOPT[2]=NOPT[2]+1:OPT$=", O2Q":RETURN
24260 AC.PI=AC.PI-5:OUT.WORD=-CO2:GOSUB 12700:AC.PI=AC.PI+3:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24270 IF PCO2>3 THEN 24220
24280 IF CO2=2 THEN OP=19 ELSE OP=20
24290 NOPT[2]=NOPT[2]+1:OPT$=", O2":IF PCO2=0 THEN AC.PI=AC.PI-5:OPT$=", O2Q":RETURN
24300 AC.PI=AC.PI-6:FOR I=1 TO PCO2:OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+OP]:GOSUB 12700:NEXT:RETURN
24400 IF OPL<2 THEN 24500
24410 GET#3,PC.PI:PCO1=CVI(CO1$):PQ1=PCO1\256:PQ2=PCO1 MOD 256:PCO2=CVI(CO2$):IF PQ1=2 AND OPL>1 AND PQ2=Q2 AND PCO2=CO2 THEN NOPT[2]=NOPT[2]+1:OPT$=", O2":OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[1]+21]:GOTO 12700
24420 IF PQ1<>3 OR OPL<3 OR PQ2<>Q2 OR PCO2<>CO2 THEN 24500 ELSE WHILE TLDX<TLDI AND TLOD[TLDX]<PC.PI:TLDX=TLDX+1:WEND:IF TLOD[TLDX]=PC.PI THEN OPT$=", X":GOTO 24500
24430 NOPT[3]=NOPT[3]+1:OPT$=", O3":OUT.BYTE=&H13:GOSUB 12600:GOTO 12600
24500 PR.INDEX=P2R[Q1 MOD 16]:STAT.LVL=Q2:IF STAT.LVL=255 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[PR.INDEX-1]:GOTO 12700
24510 OUT.BYTE=&H1:GOSUB 12600:OUT.WORD=2*CO2:GOSUB 12700:IF STAT.LVL>0 THEN OUT.BYTE=&H3E:GOSUB 12600:OUT.BYTE=STAT.LVL:GOSUB 12600
24520 OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[PR.INDEX-2*(Q1>15)-(STAT.LVL<>0)]:GOTO 12700
24600 REM:CAL LVL, PADDR
24610 STAT.LVL=Q2:IF STAT.LVL=255 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]-1]:GOTO 12700:REM CAL 255, ADDR
24620 REM: MVI A, LVL; CALL CAL:REMARK: THE CAL ROUTINE ONLY SETS UP THE PR STACK
24630 IF STAT.LVL>0 THEN OUT.BYTE=&H3E:GOSUB 12600:OUT.BYTE=STAT.LVL:GOSUB 12600
24640 OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]-(STAT.LVL>0)]:GOSUB 12700
24650 REM       JMP ADDR
24660 OUT.BYTE=&HC3:GOSUB 12600:OUT.WORD=&HEFFE:GOSUB 12000:GOTO 12700
24700 REM INT 0, N
24710 REM        LXI H, 2*N                                          CALL INT
24720 IF OPL<2 THEN 24760
24730 IF CO2=0 THEN NOPT[1]=NOPT[1]+1:OPT$=", Q":RETURN
24740 IF CO2>0 AND CO2<3 THEN FOR I=1 TO 2*CO2:OUT.BYTE=&H13:GOSUB 12600:NEXT:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24750 IF CO2>-4 AND CO2<0 THEN FOR I=1 TO -2*CO2:OUT.BYTE=&H1B:GOSUB 12600:NEXT:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24760 OUT.BYTE=&H21:GOSUB 12600:OUT.WORD=2*CO2:GOSUB 12700:OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]]:GOTO 12700
24800 REM        JMP PADDR
24810 IF OPL>0 AND CO2=PC.PI+1 THEN OPT$=", Q":NOPT[1]=NOPT[1]+1:RETURN ELSE OUT.BYTE=&HC3:GOSUB 12600:OUT.WORD=0:GOSUB 12000:GOTO 12700
24900 REM JPC 0,PADDR OR JPC 1,PADDR
24910 REM      LDAX D          ;         DCX D           ;           DCX D         ;         RAR             ;             JNC           OR            JNC
24920 IF OPL>1 AND CO2=PC.PI+1 THEN OPT$=", Q":NOPT[1]=NOP[1]+1:RETURN ELSE OUT.BYTE=&H1A:GOSUB 12600:OUT.BYTE=&H1B:GOSUB 12600:OUT.BYTE=&H1B:GOSUB 12600:OUT.BYTE=&H1F:GOSUB 12600:IF Q2=0 THEN OUT.BYTE=&HD2 ELSE OUT.BYTE=&HDA
24930 GOSUB 12600:OUT.WORD=0:GOSUB 12000:GOTO 12700
25000 REM CSP
25010 IF CO2<6 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+CO2]:GOTO 12700:REM CAL CSP
25020 IF CO2<>8 THEN PRINT"Error: unknown SP:";CO2:STOP
25030 REM: OUTPUT STRING
25040 SP8=PRTABLE[P2R[Q1]+CO2]:OLD.PC.PI=PC.PI:PC.PI=OLD.PC.PI-1:GOSUB 12300:STR.LEN=CO2:AC.PI=AC.PI-6*((STR.LEN+1)\2+1):OUT.BYTE=&H6:GOSUB 12600:OUT.BYTE=FNLOBT(STR.LEN):GOSUB 12600
25050 REM:       CALL SP8;                                                                                                     DB STRING[0], STRING[1], ...
25060 PC.PI=OLD.PC.PI:OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=SP8:GOSUB 12700:STR.BASE=OLD.PC.PI-(STR.LEN+1)\2-2
25070 FOR I=1 TO STR.LEN\2:PC.PI=STR.BASE+I:GOSUB 12300:OUT.BYTE=FNLOBT(CO2):GOSUB 12600:OUT.BYTE=FNHIBT(CO2):GOSUB 12600:NEXT
25080 IF STR.LEN MOD 2=1 THEN PC.PI=STR.BASE+(STR.LEN+1)\2:GOSUB 12300:OUT.BYTE=FNLOBT(CO2):GOSUB 12600
25090 PC.PI=OLD.PC.PI:RETURN
25100 PRINT"Illegal P-code":STOP
26000 IF DBG>0 THEN PRINT"Patching INIT"
26010 OPEN"R",#1,RTSFN$,RLN:FIELD#1,RLN AS RCRD$:OPEN"R",#2,PLN$,RLN:FIELD#2,RLN AS AC$
26020 GET#1,FNRCN(INIT.LNADR,RLN)+1:PAGENUM=FNRCN(SBM-&H100,RLN):GET#2,PAGENUM+1
26030 INIT.LEN=FNWDV(RCRD$,1):IF DBG>1 THEN PRINT"INIT is "INIT.LEN" bytes"
26040 MID$(RCRD$,4)=MKI$(SBM)
26050 MOVED=0:AC.START=FNOFS(SBM,RLN):IF DBG>1 THEN PRINT"Moving INIT to page "FNHEXN$(PAGENUM,2)", offset "FNHEXN$(AC.START,2)
26060 WHILE MOVED<INIT.LEN:TOMOVE=FNMIN(RLN-AC.START,INIT.LEN-MOVED):MID$(AC$,AC.START+1)=MID$(RCRD$,3+MOVED,TOMOVE):PUT#2,PAGENUM+1:MOVED=MOVED+TOMOVE:PAGENUM=PAGENUM+1:GET#2,PAGENUM+1:AC.START=0
26070 IF DBG>1 THEN PRINT"Moved "MOVED" bytes"
26080 WEND
26090 GET#2,1:MID$(AC$,2)=MKI$(SBM):PUT#2,1
26100 IF DBG>0 THEN PRINT" Done patching INIT"
26110 CLOSE#1,#2
26120 RETURN
27000 IF DBG>O THEN PRINT"Listing P-codes and addresses"
27010 OPEN"O",#2,PAL$
27020 GOSUB 27100
27030 IF DBG>0 THEN PRINT" Done listing P-codes and addresses"
27040 RETURN
27100 OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$,2 AS CO2$
27110 OPEN"R",#1,PXN$,2:FIELD#1,2 AS AC.PI$
27120 R=3:L=MAX.PC.PI:N=L\R-((L MOD R)<>0)
27130 FOR I=0 TO N-1:FOR J=0 TO R-1:PC.PI=I+J*N
27140 IF PC.PI>=L THEN 27170
27150 GOSUB 12300:GET#1,PC.PI+1:AC.PI=CVI(AC.PI$):IF Q1>15 THEN IDX$="X" ELSE IDX$=" "
27160 PRINT#2,USING"#####=\  \:\ \! ###_,######";PC.PI;FNHEXN$(AC.PI,4);OPCODE$[Q1 MOD 16];IDX$;Q2;CO2;
27170 NEXT J:PRINT#2,:NEXT I
27180 PRINT#2,"Stack starts at ";FNHEXN$(SBM,4)
27190 CLOSE#1,#2,#3
27200 RETURN
28000 PRINT CHR$(13);"P-Code : 8080-code = ";4*MAX.PC.PI;":"; SBM-PROGB;" = 1 :";(SBM-PROGB)/(4*MAX.PC.PI);"."
28010 IF TRF=0 THEN PRINT"No references."ELSE PRINT TRF;"references,"; N.RFRS; "forward,";TRF-N.RFRS;"backward: 1 forward per";MAX.PC.PI/N.RFRS;"P-code instructions."
28020 IF OPL=0 THEN PRINT"Optimisations off.":RETURN
28030 FOR I=1 TO OPL:PRINT USING"### level # optimisations";NOPT[I];I:NEXT
28040 RETURN
