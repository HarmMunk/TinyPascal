10 DEFINT A-Z
100 DEF FNHEXN$(A,N)=STRING$(N-LEN(HEX$(A)),"0")+HEX$(A)
110 DEF FNMEMW(I!)=I!+(I!>32767)*65536!:DEF FNABSW!(I.)=I.-(I.<0)*65536!
120 DEF FNHIBT(I)=INT(FNABSW!(I)/256):DEF FNLOBT(I)=FNABSW!(I)-FNHIBT(I)*256
130 DEF FNEOPF(CO1, CO2)= CO1=&HFFFF AND CO2=&HFFFF
140 DEF FNBTV(REC$,OFS)=ASC(MID$(REC$,OFS+1,1)):DEF FNWDV(REC$,OFS)=CVI(MID$(REC$,OFS+1,2))
150 DEF FNRCN(L,R)=INT(FNABSW!(L)/R):DEF FNOFS(L,R)=FNABSW!(L) MOD R
160 DEF FNMIN(A,B)=-(A>B)*B-(B>=A)*A
170 DEF FNRNG(A)=A>=ASC(" ")AND A<=ASC("~"):DEF FNCHAR$(A)=CHR$(A*(-FNRNG(A))-46*(NOT FNRNG(A)))
200 MJR=0:MNR=1
210 SGNON$="P-CODE TO 8080 TRANSLATOR"
220 TRF=0
230 DIM NOPT[3]
240 DIM TLOD[50]:TLDI=0
1000 PRINT SGNON$:DBG=2:OPL=3
1010 PRINT USING"Optimisation level = #. ";OPL;:INPUT"P-code file name (.PCD is assumed)";SFBN$
1020 INPUT"Want P-codes listed";PLF$
1030 TAF$=SFBN$+".$$$":TAF=2:OPEN"O",TAF,TAF$:CLOSE TAF:KILL TAF$:EXF$=SFBN$+".COM":EXF=1:OPEN"O",EXF,EXF$:CLOSE EXF:KILL EXF$
1040 PXN$=SFBN$+".PAX":PXN=1:OPEN"O",PXN,PXN$:CLOSE PXN:KILL PXN$:PAL$=SFBN$+".LSA":PAL=2:OPEN"O",PAL,PAL$:CLOSE PAL:KILL PAL$:PCF$=SFBN$+".PCD":PCF=3:OPEN"I",PCF,PCF$:CLOSE PCF
1050 GOSUB 21000
1060 RTS$="PRUN.LIB":RTS=3:RLN=128:GOSUB 22000
1070 IF OPL>2 THEN GOSUB 20000
1080 GOSUB 23000:GOSUB 26000
1090 IF LEFT$(PLF$,1)="Y"OR LEFT$(PLF$,1)="y"THEN GOSUB 27000
1100 IF DBG>0 THEN PRINT"Stack starts at ";FNHEXN$(SBM,4)
1110 NAME TAF$ AS EXF$
1120 IF DBG=0 THEN KILL PXN$
1130 GOSUB 28000
1140 END
10000 OPEN"R",#PCF,PCF$,4:FIELD#PCF,2 AS CO1$,2 AS CO2$:PCPI=0
10010 PQ1=0:PQ2=0:PCO2=0
10020 GOSUB 12300:PRINT CHR$(13)PCPI;:WHILE NOT FNEOPF(CO1,CO2):GOSUB 11000:PCPI=PCPI+1:GOSUB 12300:PRINT CHR$(13)PCPI;:WEND
10030 CLOSE#PCF:PRINT
10040 RETURN
11000 IF Q1=2 AND PQ1=3 AND Q2=PQ2 AND CO2=PCO2 THEN PRINT"STO-LOD"
11010 PQ1=Q1:PQ2=Q2:PCO2=CO2:RETURN
12000 TRF=TRF+1:IF CO2<=PCPI THEN 12100 ELSE REFS[NRFS,0]=CO2:REFS[NRFS,1]=ACPI:IF DBG>0 THEN DBG$=" Fwd"+STR$(NRFS)+": PC"+STR$(REFS[NRFS,0])
12010 NRFS=NRFS+1:RETURN
12100 GET#PXN,CO2+1:OWD=CVI(ACPI$):IF DBG>0 THEN DBG$=" Bwd: PC"+STR$(CO2)+"= AC "+FNHEXN$(OWD,4)
12110 RETURN 
12200 LSET ACPI$=MKI$(ACPI):PUT#PXN,PCPI+1:RETURN
12300 GET#PCF,PCPI+1:CO1=CVI(CO1$):CO2=CVI(CO2$):Q1=CO1\256:Q2=CO1 MOD 256:RETURN
12400 IF DBG>0 THEN PRINT USING"&=#####: && ###_,######=&=&&";FNHEXN$(ACPI,4);PCPI;OPCODE$[Q1 MOD 16];MID$("X ",2+(Q1\16<>0),1);Q2;CO2;FNHEXN$(CO2,4);FNCHAR$(CO2\256);FNCHAR$(CO2 MOD 256);:DBG$="":OPT$="":RETURN
12410 PRINT CHR$(13);PCPI;:RETURN
12500 IF DBG>0 THEN PRINT " "DBG$;OPT$
12510 RETURN
12600 LSET OBT$=CHR$(OBT):PUT#TAF,ACPI-&H100+1:ACPI=ACPI+1:RETURN
12700 OBT=FNLOBT(OWD):GOSUB 12600:OBT=FNHIBT(OWD):GOTO 12600
20000 IF DBG>0 THEN PRINT"Scanning for JMP/JPC targeting LODs"
20010 OPEN"R",#PCF,PCF$,4:FIELD#PCF,2 AS CO1$,2 AS CO2$:PCPI=0
20020 GOSUB 12300:PRINT PCPI;CHR$(13);:WHILE NOT FNEOPF(CO1,CO2):GOSUB 20100:PCPI=PCPI+1:GOSUB 12300:PRINT PCPI;CHR$(13);:WEND
20030 CLOSE#PCF
20040 IF TLDI>0 THEN GOSUB 20300:IF DBG>0 THEN PRINT" "TLDI"targeted LODs found":IF DBG>1 THEN FOR I=0 TO TLDI-1:PRINT TLOD[I]:NEXT
20050 IF TLDI>0 THEN GOSUB 20400:IF DBG>0 THEN PRINT" "TLDI"unique targeted LODs":IF DBG>1 THEN FOR I=0 TO TLDI-1:PRINT TLOD[I]:NEXT
20060 IF DBG>0 THEN PRINT" Done scanning"
20070 RETURN
20100 IF Q1<>6 AND Q1<>7 THEN RETURN
20110 GET#PCF,CO2+1:TQ1=CVI(CO1$)\256:IF TQ1<>2 THEN RETURN
20120 TLOD[TLDI]=CO2:TLDI=TLDI+1:PRINT:RETURN
20300 IF DBG>0 THEN PRINT" Sorting"
20310 FOR I=TLDI-1 TO 1 STEP -1:FOR J=0 TO I-1:IF TLOD[J]>TLOD[J+1]THEN SWAP TLOD[J],TLOD[J+1]
20320 NEXT J,I
20330 RETURN
20400 IF DBG>0 THEN PRINT" Removing duplicates"
20410 J=0:FOR I=1 TO TLDI-1:IF TLOD[I]<>TLOD[J]THEN J=J+1:TLOD[J]=TLOD[I]
20420 NEXT:IF TLDI>0 THEN TLDI=J+1
20430 RETURN
21000 DIM OPCODE$[8]:RESTORE 21000:FOR I=0 TO 8:READ OPCODE$[I]:NEXT:RETURN
21010 DATA LIT,OPR,LOD,STO,CAL,INT,JMP,JPC,CSP
22000 IF DBG>0 THEN PRINT"Reading RTS table"
22010 OPEN"R",#RTS,RTS$,RLN:FIELD#RTS,RLN AS RCRD$:GET#RTS,1:TBAD=FNWDV(RCRD$,3)-&H100:TBRN=FNRCN(TBAD,RLN):TBOF=FNOFS(TBAD,RLN):IF TBOF<>0 THEN PRINT"RTS info should start at offset 0, but offset is"TBOF:STOP
22020 IF DBG>1 THEN PRINT"RTS info on page "FNHEXN$(TBRN,2)
22030 GET#RTS,TBRN+1:VNMJ=FNBTV(RCRD$,0):VNMN=FNBTV(RCRD$,1):VNBF=FNBTV(RCRD$,2):PROGB=FNWDV(RCRD$,4):TBLA=FNWDV(RCRD$,6)-&H100:INILA=FNWDV(RCRD$,8)-&H100:STCK=FNWDV(RCRD$,10)
22040 IF VNMJ<>MJR OR VNMN<MNR THEN PRINT"Incompatible RTS version!":STOP
22050 IF DBG>1 THEN PRINT"RTS version:"VNMJ"."VNMN"."VNBF:PRINT"Translated P-code starts at "FNHEXN$(PROGB,4):PRINT"RTS table is at file address "FNHEXN$(TBLA,4):PRINT"INIT is at file address "FNHEXN$(INILA,4)
22060 GET#RTS,FNRCN(TBLA,RLN)+1:TBLN=FNWDV(RCRD$,0)
22070 DIM PRTB[63]:FOR I=O TO TBLN-1:PRTB[I]=FNWDV(RCRD$,2+2*I):NEXT:IF DBG>2 THEN PRINT"RTS addresses:":FOR I=0 TO TBLN-1:PRINT I,FNHEXN$(PRTB[I],4):NEXT:PRINT
22080 DIM P2R[8]:J=2*TBLN:FOR I=0 TO 8:P2R[I]=FNWDV(RCRD$,2+J+2*I):NEXT
22090 IF DBG>2 THEN FOR I=0 TO 8:PRINT OPCODE$[I],FNHEXN$(P2R[I],4):NEXT
22100 IF DBG>0 THEN PRINT" Done reading RTS table"
22110 IF DBG>0 THEN PRINT"Copying RTS"
22120 OPEN"R",#TAF,TAF$,RLN:FIELD#TAF,RLN AS DST$
22130 NBTS=PROGB-&H100:NPGS=(NBTS+RLN-1)\RLN:IF DBG>1 THEN PRINT" Copying "NBTS"("HEX$(NBTS)") bytes = "NPGS" ("HEX$(NPGS)") pages"
22140 FOR I=1 TO NPGS:GET#RTS,I:LSET DST$=RCRD$:PUT#TAF,I:IF DBG>1 THEN PRINT I;
22150 NEXT:IF DBG>1 THEN PRINT
22160 IF DBG>0 THEN PRINT" Done copying RTS"
22170 CLOSE #RTS,#TAF
22180 RETURN
23000 IF DBG>0 THEN PRINT"Translating"
23010 OPEN"R",#PXN,PXN$,2:FIELD#PXN,2 AS ACPI$
23020 OPEN"R",#TAF,TAF$,1:FIELD#TAF,1 AS OBT$:ACPI=PROGB
23030 OPEN"R",#PCF,PCF$,4:FIELD#PCF,2 AS CO1$,2 AS CO2$:PCPI=0
23040 DIM REFS[1000,1]:NRFS=0:TRF=0:TLDX=0
23050 GOSUB 12300:WHILE NOT FNEOPF(CO1,CO2):GOSUB 12200:GOSUB 12400:GOSUB 24000:GOSUB 12500:PCPI=PCPI+1:GOSUB 12300:WEND:IF DBG=0 THEN PRINT
23060 SBM=ACPI:MXPI=PCPI 
23100 IF DBG>0 THEN PRINT"Fixing"NRFS"references"
23110 FOR RFIX=0 TO NRFS-1:PCAD=REFS[RFIX,0]:ACPI=REFS[RFIX,1]:GET#PXN,PCAD+1:OWD=CVI(ACPI$)
23120 IF DBG>0 THEN IF DBG>1 THEN PRINT"Forward reference: P-code address is "PCAD" = "FNHEXN$(OWD,4)" @ "FNHEXN$(ACPI,4) ELSE PRINT RFIX+1;CHR$(13);
23130 GOSUB 12700:NEXT
23140 CLOSE#PXN,#TAF,#PCF
23150 IF DBG>0 THEN PRINT" Done translating and fixing references"
23160 RETURN
24000 ON (Q1 MOD 16)+1 GOTO 24100,24200,24400,24500,24600,24730,24810,24920,25010,25100,25100,25100,25100,25100,25100,25100
24010 REM: TRANSLATE:       LIT   OPR   LOD   STO   CAL   INT   JMP   JPC   CSP   ERR...
24100 REM:LIT 0,N: LXI B,N:CALL LIT
24110 IF OPL>1 AND CO2=0 THEN 24140
24120 OBT=&H1:GOSUB 12600:OWD=CO2:GOSUB 12700
24130 OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]]:GOTO 12700
24140 OBT=&HAF:GOSUB 12600:FOR I=1 TO 2:OBT=&H13:GOSUB 12600:OBT=&H12:GOSUB 12600:NEXT:OBT=&HCD:GOSUB 12600:OWD=STCK:GOSUB 12700
24150 NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24200 REM OPR 0,N: CALL OPR00$NN, EXCEPT FOR OPR 0,0: JMP OPR00$00
24210 IF OPL>1 AND (CO2=1 OR CO2=2 OR CO2=3)THEN 24240
24220 IF CO2=0 THEN OBT=&HC3 ELSE OBT=&HCD
24230 GOSUB 12600:OWD=PRTB[P2R[Q1]+CO2]:GOTO 12700
24240 GET#PCF,PCPI:PCO1=CVI(CO1$):PCO2=CVI(CO2$):PQ1=PCO1\256:IF PQ1<>0 THEN 24220 ELSE IF CO2=1 THEN 24250 ELSE IF CO2=2 OR CO2=3 THEN 24270 ELSE STOP'CO2 (=OPR)  SHOULD BE 1, 2 OR 3
24250 IF PCO2=0 THEN NOPT[2]=NOPT[2]+1:OPT$=", O2Q":RETURN
24260 ACPI=ACPI-5:OWD=-CO2:GOSUB 12700:ACPI=ACPI+3:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24270 IF PCO2>3 THEN 24220
24280 IF CO2=2 THEN OP=19 ELSE OP=20
24290 NOPT[2]=NOPT[2]+1:OPT$=", O2":IF PCO2=0 THEN ACPI=ACPI-8:OPT$=", O2Q":RETURN
24300 ACPI=ACPI-6:FOR I=1 TO PCO2:OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]+OP]:GOSUB 12700:NEXT:RETURN
24400 IF OPL<2 THEN 24500
24410 GET#PCF,PCPI:PCO1=CVI(CO1$):PQ1=PCO1\256:PQ2=PCO1 MOD 256:PCO2=CVI(CO2$):IF PQ1=2 AND OPL>1 AND PQ2=Q2 AND PCO2=CO2 THEN NOPT[2]=NOPT[2]+1:OPT$=", O2":OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[1]+21]:GOSUB 12700:OBT=&HCD:GOSUB 12600:OWD=STCK:GOTO 12700
24420 IF PQ1<>3 OR OPL<3 OR PQ2<>Q2 OR PCO2<>CO2 THEN 24500 ELSE WHILE TLDX<TLDI AND TLOD[TLDX]<PCPI:TLDX=TLDX+1:WEND:IF TLOD[TLDX]=PCPI THEN OPT$=", X":GOTO 24500
24430 NOPT[3]=NOPT[3]+1:OPT$=", O3":OBT=&H13:GOSUB 12600:GOTO 12600
24500 PRIX=P2R[Q1 MOD 16]:STLV=Q2:IF STLV=255 THEN OBT=&HCD:GOSUB 12600:OWD=PRTB[PRIX-1]:GOTO 12700
24510 OBT=&H1:GOSUB 12600:OWD=2*CO2:GOSUB 12700:IF STLV>0 THEN OBT=&H3E:GOSUB 12600:OBT=STLV:GOSUB 12600
24520 OBT=&HCD:GOSUB 12600:OWD=PRTB[PRIX-2*(Q1>15)-(STLV<>0)]:GOTO 12700
24600 REM:CAL LVL, PADDR
24610 STLV=Q2:IF STLV=255 THEN OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]-1]:GOTO 12700:REM CAL 255, ADDR
24620 REM: MVI A, LVL; CALL CAL:REMARK: THE CAL ROUTINE ONLY SETS UP THE PR STACK
24630 IF STLV>0 THEN OBT=&H3E:GOSUB 12600:OBT=STLV:GOSUB 12600
24640 OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]-(STLV>0)]:GOSUB 12700
24650 REM       JMP ADDR
24660 OBT=&HC3:GOSUB 12600:OWD=&HEFFE:GOSUB 12000:GOTO 12700
24700 REM INT 0, N
24710 REM        LXI H, 2*N                                          CALL INT
24720 IF OPL<1 THEN 24760
24730 IF CO2=0 THEN NOPT[1]=NOPT[1]+1:OPT$=", Q":RETURN
24740 IF OPL>1 AND CO2>0 AND CO2<3 THEN FOR I=1 TO 2*CO2:OBT=&H13:GOSUB 12600:NEXT:OBT=&HCD:GOSUB 12600:OWD=STCK:GOSUB 12700:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24750 IF OPL>1 AND CO2>-4 AND CO2<0 THEN FOR I=1 TO -2*CO2:OBT=&H1B:GOSUB 12600:NEXT:NOPT[2]=NOPT[2]+1:OPT$=", O2":RETURN
24760 OBT=&H21:GOSUB 12600:OWD=2*CO2:GOSUB 12700:OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]]:GOTO 12700
24800 REM        JMP PADDR
24810 IF OPL>0 AND CO2=PCPI+1 THEN OPT$=", Q":NOPT[1]=NOPT[1]+1:RETURN ELSE OBT=&HC3:GOSUB 12600:OWD=0:GOSUB 12000:GOTO 12700
24900 REM JPC 0,PADDR OR JPC 1,PADDR
24910 REM      LDAX D          ;         DCX D           ;           DCX D         ;         RAR             ;             JNC           OR            JNC
24920 IF OPL>1 AND CO2=PCPI+1 THEN OPT$=", Q":NOPT[1]=NOP[1]+1:RETURN ELSE OBT=&H1A:GOSUB 12600:OBT=&H1B:GOSUB 12600:OBT=&H1B:GOSUB 12600:OBT=&H1F:GOSUB 12600:IF Q2=0 THEN OBT=&HD2 ELSE OBT=&HDA
24930 GOSUB 12600:OWD=0:GOSUB 12000:GOTO 12700
25000 REM CSP
25010 IF CO2<6 THEN OBT=&HCD:GOSUB 12600:OWD=PRTB[P2R[Q1]+CO2]:GOTO 12700:REM CAL CSP
25020 IF CO2<>8 THEN PRINT"Error: unknown SP:";CO2:STOP
25030 REM: OUTPUT STRING
25040 SP8=PRTB[P2R[Q1]+CO2]:OPCI=PCPI:PCPI=OPCI-1:GOSUB 12300:STLN=CO2:ACPI=ACPI-6*((STLN+1)\2+1):OBT=&H6:GOSUB 12600:OBT=FNLOBT(STLN):GOSUB 12600
25050 REM:       CALL SP8;                                                                                                     DB STRING[0], STRING[1], ...
25060 PCPI=OPCI:OBT=&HCD:GOSUB 12600:OWD=SP8:GOSUB 12700:SBSE=OPCI-(STLN+1)\2-2
25070 FOR I=1 TO STLN\2:PCPI=SBSE+I:GOSUB 12300:OBT=FNLOBT(CO2):GOSUB 12600:OBT=FNHIBT(CO2):GOSUB 12600:NEXT
25080 IF STLN MOD 2=1 THEN PCPI=SBSE+(STLN+1)\2:GOSUB 12300:OBT=FNLOBT(CO2):GOSUB 12600
25090 PCPI=OPCI:RETURN
25100 PRINT"Illegal P-code":STOP
26000 IF DBG>0 THEN PRINT"Patching INIT"
26010 OPEN"R",RTS,RTS$,RLN:FIELD#RTS,RLN AS RCRD$:OPEN"R",#TAF,TAF$,RLN:FIELD#TAF,RLN AS AC$
26020 GET#RTS,FNRCN(INILA,RLN)+1:PAGENUM=FNRCN(SBM-&H100,RLN):GET#TAF,PAGENUM+1
26030 INIT.LEN=FNWDV(RCRD$,0):IF DBG>1 THEN PRINT"INIT is "INIT.LEN" bytes"
26040 MID$(RCRD$,4)=MKI$(SBM)
26050 MOVED=0:AC.START=FNOFS(SBM,RLN):IF DBG>1 THEN PRINT"Moving INIT to page "FNHEXN$(PAGENUM,2)", offset "FNHEXN$(AC.START,2)
26060 WHILE MOVED<INIT.LEN:TOMOVE=FNMIN(RLN-AC.START,INIT.LEN-MOVED):MID$(AC$,AC.START+1)=MID$(RCRD$,3+MOVED,TOMOVE):PUT#TAF,PAGENUM+1:MOVED=MOVED+TOMOVE:PAGENUM=PAGENUM+1:GET#TAF,PAGENUM+1:AC.START=0
26070 IF DBG>1 THEN PRINT"Moved "MOVED" bytes"
26080 WEND
26090 GET#TAF,1:MID$(AC$,2)=MKI$(SBM):PUT#TAF,1
26100 IF DBG>0 THEN PRINT" Done patching INIT"
26110 CLOSE#RTS,#TAF
26120 RETURN
27000 IF DBG>O THEN PRINT"Listing P-codes and addresses"
27010 GOSUB 27100
27020 IF DBG>0 THEN PRINT" Done listing P-codes and addresses"
27030 RETURN
27100 OPEN"R",#PXN,PXN$,2:FIELD#PXN,2 AS ACPI$
27110 OPEN"O",#PAL,PAL$
27120 OPEN"R",#PCF,PCF$,4:FIELD#PCF,2 AS CO1$,2 AS CO2$
27130 R=3:L=MXPI:N=L\R-((L MOD R)<>0)
27140 FOR I=0 TO N-1:FOR J=0 TO R-1:PCPI=I+J*N
27150 IF PCPI>=L THEN 27170
27160 GOSUB 12300:GET#PXN,PCPI+1:ACPI=CVI(ACPI$):IF Q1>15 THEN IDX$="X" ELSE IDX$=" "
27170 PRINT#PAL,USING"#####=\  \:\ \! ###_,######";PCPI;FNHEXN$(ACPI,4);OPCODE$[Q1 MOD 16];IDX$;Q2;CO2;
27180 NEXT J:PRINT#PAL,:NEXT I
27190 PRINT#PAL,"Stack starts at ";FNHEXN$(SBM,4)
27200 CLOSE#PXN,#PAL,#PCF
27210 RETURN
28000 PRINT CHR$(13);"P-Code : 8080-code = ";4*MXPI;":"; SBM-PROGB;" = 1 :";(SBM-PROGB)/(4*MXPI);"."
28010 IF TRF=0 THEN PRINT"No references."ELSE PRINT TRF;"references,"; NRFS; "forward,";TRF-NRFS;"backward: 1 forward per";MXPI/NRFS;"P-code instructions."
28020 IF OPL=0 THEN PRINT"Optimisations off.":RETURN
28030 FOR I=1 TO OPL:PRINT USING"### level # optimisations";NOPT[I];I:NEXT
28040 RETURN
