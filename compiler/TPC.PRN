10920 IF T1[TI]=-1 THEN IF AA$="WRITELN"OR AA$="WRITE"THEN 11150 ELSE IF AA$="READ"THEN 11220 ELSE IF AA$="CALL" THEN 11250 ELSE GOSUB 10160:STOP
10930 GOSUB 10280:GOSUB 10600:Q1=4:Q2=L1-T1[TI]:Q3=T2[TI]:GOSUB 11690:IF T3[TI]<>0 THEN Q1=5:Q2=0:Q3=-T3[TI]:GOTO 11690 ELSE RETURN
10940 GOSUB 10280:GOSUB 10750:K$="OF":E=20:GOSUB 10020:X=C1:GOSUB 11650:NC=C1:GOSUB 10960:WHILE S0$=";":GOSUB 10280:GOSUB 10960:WEND:IF S0$="OTHERWISE"OR S0$="ELSE"THEN GOSUB 10280:X=NC:GOSUB 11650:GOSUB 10880:GOSUB 11660:NC=X
