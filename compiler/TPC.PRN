10 DEFINT A-Z:GOTO 100
20 IF C0<L0 THEN C0=C0+1:X$=MID$(L$,C0,1):IF X$="	"THEN C8=C8+TABLEN-(C8 MOD TABLEN):RETURN ELSE C8=C8+1:RETURN
30 GOSUB 10200:GOTO 20
100 DEF FNUC$(A$)=CHR$((ASC(A$)>=ASC("a")AND ASC(A$)<=ASC("z"))*(ASC("a")-ASC("A"))+ASC(A$))
110 DEF FNLC$(A$)=CHR$((ASC(A$)>=ASC("A")AND ASC(A$)<=ASC("z"))*(ASC("A")-ASC("a"))+ASC(A$))
1000 INPUT"Source file base name (.PAS is assumed)";SFBN$:IF INSTR(SFBN$,".")<>0 THEN SFBN$=LEFT$(SFBN$,INSTR(SFBN$,".")-1)
1010 SFN$=SFBN$+".PAS":OPEN"I",#1,SFN$
1020 LFN$=SFBN$+".LST":OPEN"O",#2,LFN$
1030 PFN$=SFBN$+".PCD":OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$, 2 AS CO2$
1040 VERSION!=2.2
1050 T0=100:REM MAXIMUM SYMBOL TABLE SIZE
1060 MAXINT=32767
1070 N2=8:REM MAX IDENTIFIER LENGTH
1080 C1=0:C0=0:L0=0:REM:C0: CURRENT INPUT CHARACTER COLUMN NUMBER, L0: INPUT LINE NUMBER LENGTH
1090 DIM T$[T0]:REM SYMBOL TABLE: SYMBOL
1100 DIM T0$[T0]:REM SYMBOL TABLE: TYPE: C=CONSTANT, S=SYSTEM FUNCTION, F=FUNCTION, P=PROCEDURE, M=MAIN PROGRAM: O=ARRAY, E=ARRAY DIMENSION
1110 L1=0:REM SCOPE LEVEL
1120 DIM S[100],S$[100]: REM STACKS
1130 DIM T1[T0]:REM SYMBOL TABLE: BLOCK LEVEL
1140 DIM T2[T0]:REM SYMBOL TABLE: VALUE, OR PCODE OPERATION NR
1150 DIM T3[T0]:REM SYMBOL TABLE: "F" OR "P" NUMBER OF PARAMS
1160 RESTORE 1190:READ W0$:CR$=CHR$(13):ESC$=CHR$(27):AT$=CHR$(64):TABLEN=8:FIRSTINDENT=11
1170 I2=INSTR(W0$,","):I1=INSTR(I1+1,W0$,","):WHILE I1<>0:IDLEN=I1-I2-1:IF N2<IDLEN THEN N2=IDLEN
1180 I2=I1:I1=INSTR(I1+1,W0$,","):WEND
1190 DATA",AND,ARRAY,BEGIN,BOOLEAN,CASE,CHAR,CONST,DIV,DO,DOWNTO,ELSE,END,EXTERNAL,FOR,FORWARD,FUNCTION,IF,INTEGER,MOD,NOT,OF,OR,OTHERWISE,PROCEDURE,PROGRAM,REPEAT,SHL,SHR,THEN,TO,UNTIL,VAR,WHILE,"
1200 DIM M$[8]:REM P-CODE MNEMONICS
1210 RESTORE 1210:FOR I=O TO 8:READ M$[I]:NEXT:DATA LIT,OPR,LOD,STO,CAL,INT,JMP,JPC,CSP
1220 RESTORE 1240:READ N:FOR T1=1 TO N:READ T$[2*T1-1],T0$[2*T1-1],T1[2*T1-1],T2[2*T1-1],T3[2*T1-1]:T$[2*T1]=T$[2*T1-1]:T0$[2*T1]=T0$[2*T1-1]:T1[2*T1]=T1[2*T1-1]:T2[2*T1]=T2[2*T1-1]:T3[2*T1]=T3[2*T1-1]
1230 FOR I=1 TO LEN(T$[2*T1]):MID$(T$[2*T1],I,1)=FNLC$(MID$(T$[2*T1],I,1)):NEXT I:NEXT T1:T1=2*N:BI=T1:L1=-1
1240 DATA 14
1250 DATA TRUE,C,-1,1,0,FALSE,C,-1,0,0,MAXINT,C,-1,32767,0,MININT,C,-1,-32768,0,MEM,S,-1,0,0,ODD,F,-1,6,1,SUCC,F,-1,19,1,PRED,F,-1,20,1,READ,P,-1,0,-1,WRITE,P,-1,0,-1,WRITELN,P,-1,0,-1,BDOS,F,-1,22,2
1260 DATA STACKTOP,F,-1,23,1,CALL,P,-1,0,1
1270 GOSUB 10100
1280 P8=0
1290 P7=0:P9=P7
1300 Q9=0:REM Maximum p-code program size: IS NOW 2^16 / 2, SEE BELOW
1310 F5=1:F10=-1:EF=0:REM F5:?, F10:?, EF: ERROR FLAG
1320 PRINT"TINY PASCAL COMPILER"
1330 IF TDRIVER=0 THEN INPUT"Want listing";Y$:Y10=LEFT$(Y$,1)="Y"ELSE Y10=-1:REM Y10: Listing flag
1340 IF TDRIVER=0 THEN INPUT"Want symbol table";Y$:Y12=LEFT$(Y$,1)="Y"ELSE Y12=-1:REM Y12: Symbol table listing flag
1350 Y11=-1:REM INPUT"Want p-code file";Y$:Y11=LEFT$(Y$,1)="Y":REM Y11: Code file flag: ignored
1360 IF TDRIVER=0 THEN INPUT"Want code printed";Y$:Y9=LEFT$(Y$,1)="Y"ELSE Y9=0:REM Y9: Code printed flag
1370 Q9=16383:REM INPUT"p-code program size [default=2048 instructions]";Q9:IF Q9<0 THEN 1240 ELSE IF Q9=0 THEN Q9=2048 
1380 REM Q9=(Q9-1)*2:DIM CO[Q9]:REM CO: P-code program
1390 HD$="TINY-PASCAL P-CODE COMPILER VERSION"+STR$(VERSION!)
1400 HD1$="Line Loc. Source"
1410 PRINT HD$:PRINT HD1$:IF Y10 THEN PRINT#2,HD$:PRINT#2,HD1$
1420 X$=" ":GOSUB 10280
1430 'WHILE S0$<>".":GOSUB 1720:WEND:STOP
1440 IF S0$="PROGRAM"THEN K$="PROGRAM":E=35:GOSUB 10020:K$="IDENT":E=4:GOSUB 10010:GOSUB 10430:T0$[T1]="M":T2[T1]=C1:GOSUB 10280:K$=";":E=7:GOSUB 10020
1450 L1=L1+1:BI=T1:GOSUB 11270:L1=L1-1:T1=BI:GOSUB 12210:K$=".":E=6:GOSUB 10010
1460 LSET CO1$=MKI$(&HFFFF):LSET CO2$=MKI$(&HFFFF):PUT#3,C1+1:PRINT:REM CO[P9]=&HFFFF
1470 IF Y10 THEN PRINT#2,STRING$(3,13)ELSE PRINT STRING$(2,13)
1480 IF TDRIVER=0 THEN IF NOT Y9 THEN INPUT"Want to see P-codes";Y$
1490 IF LEFT$(Y$,1)="Y"OR Y9 THEN W0$="":ERASE T$,T0$,S,S$,T1,T2,T3,ER$:X=FRE(""):IF NOT EF THEN GOSUB 11800
1500 REM IF NOT Y11 THEN 1470
1510 CLOSE#1,#2,#3:IF EF THEN KILL PFN$
1520 IF EF THEN PRINT"ERRORS FOUND!"
1530 IF TDRIVER=0 OR EF THEN END ELSE EXITSTATUS=1:COMMON TDRIVER,EXITSTATUS,SFBN$:CHAIN"TRANS"
10000 REM ********** CHOMP: EAT NEXT SYMBOL IF IS EQUAL TO K$ AND GET NEXT SYMBOL. OTHERWISE, THIS IS AN ERROR.
10010 IF S0$<>K$THEN E9=E:GOSUB 10040:STOP ELSE RETURN
10020 GOSUB 10010:GOTO 10280
10030 REM ********** PRINT ERROR MESSAGE, RAISE ERROR FLAG
10040 PRINT TAB(C7)"^"E9:IF Y10 THEN PRINT#2,TAB(C7)"^" 
10050 GOSUB 10070:EF=-1
10060 RETURN
10070 PRINT ER$[E9-1]:IF Y10 THEN PRINT#2,ER$[E9-1]
10080 RETURN
10090 REM ********** READ ERROR MESSAGES
10100 RESTORE 10110:READ ME:DIM ER$[ME-1]:FOR I=0 TO ME-1:READ ER$[I]:NEXT:RETURN
10110 DATA 37
10120 DATA Mem full,Constant expected,'=' expected,Identifier expected,"':' missing",'.' expected,"';' missing",Undeclared indentifier,Illegal identifier,"':=' expected",'THEN' expected,'END' expected,'DO' expected,Incorrect symbol
10130 DATA Bad expression,Use of procedure identifier in expression,')' expected,Illegal factor,'BEGIN' expected,'OF' expected,Illegal hexadecimal constant,'TO' or "DOWNTO' expected,Number out of range,'(' expected,'[' expected,']' expected
10140 DATA Not enough parameters,Data type not recognised, Identifier declared twice,Empty string not allowed,"',' expected",'..' expected,Low bound larger than high bound,String not allowed,'PROGRAM' expected,'UNTIL' expected,Not enough indices
10150 REM ********** GET NEXT CHARACTER
10160 PRINT TAB(C7)"^":PRINT"BUG":RETURN
10170 PRINT"Do not call 1630!":STOP:WHILE C0>=L0:GOSUB 10200:WEND:C0=C0+1:X$=MID$(L$,C0,1):IF X$="	"THEN C8=C8+TABLEN-(C8 MOD TABLEN) ELSE C8=C8+1
10180 RETURN
10190 REM ********** GET NEXT INPUT LINE
10200 LINE.NR=LINE.NR+1:PRINT USING"#### ##### ";LINE.NR;C1;:F5=ABS(F5) MOD 2:ON F5+1 GOSUB 10250,10260:IF F5>0 THEN PRINT L$
10210 IF Y10 THEN PRINT#2,USING"#### ##### &";LINE.NR;C1;L$
10220 IF LEFT$(L$,1)="$"THEN IF MID$(L$,2,1)="+"THEN F5=F5+1:GOTO 10200 ELSE IF MID$(L$,2,1)="-"THEN F5=F5-1:GOTO 10200 ELSE PRINT SPC$(6)"^Ignored":GOTO 10200
10230 L$=L$+CR$:C0=0:C8=FIRSTINDENT:L0=LEN(L$)
10240 RETURN
10250 PRINT CHR$(8);:LINE INPUT L$:RETURN
10260 LINE INPUT#1,L$:RETURN
10270 REM ********** GET NEXT TOKEN
10280 WHILE X$=" "OR X$="	"OR X$=CR$:GOSUB 20:WEND
10290 IF X$="{"THEN GOSUB 20:WHILE X$<>"}":GOSUB 20:WEND:GOSUB 20:GOTO 10280
10300 C7=C8:C9=C0:IF X$>="A"AND X$<="Z"OR X$>="a"AND X$<="z"THEN 10310 ELSE IF X$>="0"AND X$<="9" THEN 10340 ELSE 10350
10310 K=0:WHILE X$>="A"AND X$<="Z"OR X$>="a"AND X$<="z"OR X$>="0"AND X$<="9"OR X$ ="_":K=K+1:REM IFT0S K<N2 THEN K=K+1
10320 GOSUB 20:WEND:A$=MID$(L$,C9,K):AA$=A$:FOR K=1 TO LEN(A$):MID$(AA$,K,1)=FNUC$(MID$(AA$,K,1)):NEXT:IF INSTR(W0$,","+AA$+",")<>0 THEN S0$=AA$ ELSE S0$="IDENT"
10330 RETURN
10340 S0$="NUM":K=0:WHILE X$>="0"AND X$<="9":K=K+1:GOSUB 20:WEND:N3!=VAL(MID$(L$,C9,K)):IF MININT<=N3! AND N3!<=MAXINT THEN N3=CINT(N3!):RETURN ELSE E9=23:GOTO 10040
10350 S0$=X$:GOSUB 20:IF S0$="%"THEN 10360 ELSE IF S0$=":" THEN 10370 ELSE IF S0$="<" THEN 10380 ELSE IF S0$=">" THEN 10390 ELSE IF S0$="." THEN 10400 ELSE IF S0$="'" THEN 10410 ELSE RETURN
10360 IF X$>="0"AND X$<="9"OR FNUC$(X$)>="A"AND FNUC$(X$)<="F"THEN K=0:S0$="NUM":WHILE X$>="0"AND X$<="9"OR FNUC$(X$)>="A"AND FNUC$(X$)<="F":K=K+1:GOSUB 20:WEND:IF K<=4 THEN N3=VAL("&H"+MID$(L$,C9+1,K)):RETURN ELSE E9=23:GOTO 10040 ELSE RETURN
10370 IF X$="=" THEN S0$=":=":GOTO 20 ELSE RETURN
10380 IF X$="="THEN S0$="<=":GOTO 20 ELSE IF X$=">"THEN S0$="<>":GOTO 20 ELSE RETURN
10390 IF X$="=" THEN S0$=">=":GOSUB 20:RETURN ELSE RETURN
10400 IF X$="." THEN S0$="..":GOTO 20 ELSE RETURN
10410 C$=""
10420 IF X$="'"THEN GOSUB 20:IF X$="'" THEN C$=C$+X$:GOSUB 20:GOTO 10420 ELSE IF LEN(C$)=0 THEN E9=30:GOTO 10040 ELSE IF LEN(C$)=1 THEN S0$="CHR":RETURN ELSE S0$="STR":RETURN ELSE C$=C$+X$:GOSUB 20:GOTO 10420
10430 GOSUB 10450:IF TI<>0 AND T1[TI]=L1 THEN TI=0:E9=29:GOTO 10040 ELSE T1=T1+1:T$[T1]=A$:T1[T1]=L1:TI=T1:RETURN
10440 GOSUB 10450:IF TI=0 THEN E9=8:GOTO 10040 ELSE RETURN
10450 T$[0]="":TI=T1:WHILE TI<>0 AND T$[TI]<>A$:TI=TI-1:WEND:RETURN
10460 K$="IDENT":E=4:GOSUB 10010:GOSUB 10430:T0$[TI]="?":GOSUB 10280:K$="=":E=3:GOSUB 10020:GOSUB 10470:T0$[TI]="C":T2[TI]=CV:RETURN
10470 IF S0$="+"OR S0$="-"THEN Y$=S0$:GOSUB 10280 ELSE Y$=""
10480 GOSUB 11670:IF S0$="NUM"THEN CV=N3:GOTO 10500 ELSE IF S0$="CHR" THEN CV=ASC(C$):GOTO 10500 ELSE IF S0$="STR"THEN E9=34:GOSUB 10040:CV=ASC(C$):GOTO 10500
10490 K$="IDENT":E=2:GOSUB 10010:GOSUB 10440:CV=T2[TI]:IF T0$[TI]<>"C" THEN E9=9:GOSUB 10040
10500 GOSUB 11680:IF Y$="-"THEN CV=-CV
10510 GOTO 10280
10520 REM ********** PARSE LEFT SIDE OF ASSIGNMENT **********
10530 IF T0$[TI]="V"OR T0$[TI]="R" THEN 10280:REM VARIABLE OR FUNCTION RESULT
10540 IF T0$[TI]="S"THEN X=TI:GOSUB 11650:GOSUB 10280:K$="[":E=25:GOSUB 10020:GOSUB 10750:K$="]":E=26:GOSUB 10020:GOSUB 11660:TI=X:RETURN: REM MEM[INDEX]
10550 REM PARSE ARRAY INDICES
10560 GOSUB 10280:K$="[":E=25:GOSUB 10020:II=T3[TI]:NI=T2[II]:I=1:X=TI:GOSUB 11650:GOSUB 10590:WHILE I<NI AND S0$=",":GOSUB 10280:I=I+1:IF T2[II+I]<>1 THEN Q1=0:Q2=0:Q3=T2[II+I]:GOSUB 11690:Q1=1:Q3=4:GOSUB 11690
10570 GOSUB 10590:Q1=1:Q2=0:Q3=2:GOSUB 11690:WEND:IF I<NI THEN E9=37:GOSUB 10040
10580 K$="]":E=26:GOSUB 10020:GOSUB 11660:TI=X:IF T3[II]<>0 THEN Q1=0:Q2=0:Q3=T3[II]:GOSUB 11690:Q1=1:Q3=3:GOTO 11690 ELSE RETURN
10590 X=II:GOSUB 11650:X=NI:GOSUB 11650:X=I:GOSUB 11650:GOSUB 10750:GOSUB 11660:I=X:GOSUB 11660:NI=X:GOSUB 11660:II=X:RETURN
10600 IF T3[TI]=0 THEN RETURN ELSE K$="(":E=24:GOSUB 10020:I=1:GOSUB 10620:WHILE I<T3[TI]AND S0$=",":I=I+1:GOSUB 10280:GOSUB 10620:WEND:IF I<T3[TI]THEN E9=27:GOSUB 10040
10610 K$=")":E=17:GOTO 10020
10620 X=I:GOSUB 11650:X=TI:GOSUB 11650:GOSUB 10750:GOSUB 11660:TI=X:GOSUB 11660:I=X:RETURN
10630 IF S0$="IDENT"THEN 10640 ELSE IF S0$="NUM"THEN 10710 ELSE IF S0$="STR"THEN E9=34:GOSUB 10040:GOTO 10720 ELSE IF S0$="CHR"THEN 10720 ELSE IF S0$="("THEN GOSUB 10280:GOSUB 10750:K$=")":E=17:GOTO 10020 ELSE IF S0$="NOT"THEN 10730 ELSE E9=15:GOSUB 10040
10640 GOSUB 10440:IF TI=0 THEN 10280 ELSE IF T0$[TI]="V"OR T0$[TI]="A"OR T0$[TI]="S"THEN 10650 ELSE IF T0$[TI]="P"OR T0$[TI]="F"OR T0$[TI]="R"THEN 10660 ELSE IF T0$[TI]="C"THEN 10700 ELSE E9=9:GOTO 10040
10650 GOSUB 10530:GOTO 11110
10660 IF T0$[TI]="P"THEN E9=16:GOSUB 10040:GOSUB 10280:GOTO 10600
10670 IF T0$[TI]="R" THEN TI=TI-1
10680 IF T1[TI]<>-1 THEN Q1=5:Q2=0:Q3=1:GOSUB 11690:GOSUB 10280:GOSUB 10600:Q1=4:Q2=L1-T1[TI]:Q3=T2[TI]:GOSUB 11690:Q1=5:Q2=0:Q3=-T3[TI]:GOTO 11690
10690 GOSUB 10280:GOSUB 10600:Q1=1:Q2=0:Q3=T2[TI]:GOTO 11690
10700 Q1=0:Q2=0:Q3=T2[TI]:GOSUB 11690:GOTO 10280
10710 Q1=0:Q2=0:Q3=N3:GOSUB 11690:GOTO 10280
10720 Q1=0:Q2=0:Q3=ASC(C$):GOSUB 11690:GOTO 10280
10730 GOSUB 10280:GOSUB 10630:Q1=1:Q2=0:Q3=16:GOTO 11690
10740 REM ********** PARSE RELATIONAL EXPRESSION **********
10750 GOSUB 10790:IF S0$<>"="AND S0$<>"<>"AND S0$<>"<"AND S0$<>"<="AND S0$<>">"AND S0$<>">=" THEN RETURN
10760 Y$=S0$:GOSUB 11670:GOSUB 10280:GOSUB 10790:GOSUB 11680:IF Y$="="THEN Q3=8 ELSE IF Y$="<>"THEN Q3=9 ELSE IF Y$="<"THEN Q3=10 ELSE IF Y$=">="THEN Q3=11 ELSE IF Y$=">"THEN Q3=12 ELSE IF Y$="<="THEN Q3=13 ELSE GOSUB 10160:STOP
10770 Q1=1:Q2=0:GOTO 11690
10780 REM ********** PARSE ARITHMETICAL EXPRESSION **********
10790 IF S0$="+"OR S0$="-"THEN Y$=S0$:GOSUB 10280 ELSE Y$="+"
10800 GOSUB 11670:GOSUB 10840:GOSUB 11680:IF Y$="-"THEN Q1=1:Q2=0:Q3=1:GOSUB 11690
10810 WHILE S0$="+"OR S0$="-"OR S0$="OR":Y$=S0$:GOSUB 11670:GOSUB 10280:GOSUB 10840:GOSUB 11680:GOSUB 10820:WEND:RETURN
10820 IF Y$="+"THEN Q3=2 ELSE IF Y$="-"THEN Q3=3 ELSE IF Y$="OR" THEN Q3=14 ELSE GOSUB 10160:STOP
10830 Q1=1:Q2=0:GOTO 11690
