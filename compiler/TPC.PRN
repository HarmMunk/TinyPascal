10850 IF Y$="*"THEN Q3=4 ELSE IF Y$="DIV"THEN Q3=5 ELSE IF Y$="MOD" THEN Q3=7 ELSE IF Y$="AND"THEN Q3=15 ELSE IF Y$="SHL"THEN Q3=17 ELSE IF Y$="SHR" THEN Q3=18 ELSE GOSUB 10160:STOP
10860 Q1=1:Q2=0:GOTO 11690
10870 REM *********** PARSE STATEMENTS **********
10880 IF S0$="IDENT"THEN 10890 ELSE IF S0$="BEGIN"THEN 11100 ELSE IF S0$="IF"THEN 11010 ELSE IF S0$="CASE"THEN 10940 ELSE IF S0$="WHILE" THEN 11080 ELSE IF S0$="REPEAT"THEN 11090 ELSE IF S0$="FOR"THEN 11030 ELSE RETURN
10890 GOSUB 10440:IF T0$[TI]="V"OR T0$[TI]="A"OR T0$[TI]="R"OR T0$[TI]="S"THEN 10910 ELSE IF T0$[TI]="P"THEN 10920 ELSE E9=9:GOSUB 10040:GOTO 10280
10900 REM *********** PARSE ASSIGNMENT **********
