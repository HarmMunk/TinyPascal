10 DEFINT A-Z:FALSE=0:TRUE=NOT FALSE
100 CLS$=CHR$(27)+"[2J"+CHR$(27)+"[H":SGNON$="P-CODE TO 8080 TRANSLATOR"
110 DEF FNHEXN$(A,N)=STRING$(N-LEN(HEX$(A)),"0")+HEX$(A)
120 DEF FNMEMW(I!)=I!+(I!>32767)*65536!:DEF FNABSW!(I.)=I.-(I.<0)*65536!
140 DEF FNHIGH.BYTE(I)=INT(FNABSW!(I)/256):DEF FNLOW.BYTE(I)=FNABSW!(I)-FNHIGH.BYTE(I)*256
150 DEF FNEO.PCFILE(CO1, CO2)= CO1=&HFFFF AND CO2=&HFFFF
170 DEF FNBTV(REC$,OFS)=ASC(MID$(REC$,OFS,1)):DEF FNWDV(REC$,OFS)=CVI(MID$(REC$,OFS,2))
180 DEF FNRCN(L,R)=INT(FNABSW!(L)/R):DEF FNOFS(L,R)=FNABSW!(L) MOD R
190 DEF FNMIN(A,B)=-(A>B)*B-(B>=A)*A:DEF FNMAX(A,B)=-(A<B)*B-(A>=B)*A
200 MJR=0:MNR=1:REM RTS version number
210 TRF=0
1000 PRINT SGNON$:DBG=1
1010 INPUT"P-code file name (.PCD is assumed)";SFBN$
1020 PFN$=SFBN$+".PCD":PLN$=SFBN$+".$$$":EXF$=SFBN$+".COM":PXN$=SFBN$+".PAX":PAL$=SFBN$+".LSA":OPEN"I",#1,PFN$:CLOSE#1
1030 GOSUB 20000
1040 RTSFN$="PRUN.LIB":RLN=128:GOSUB 21000
1050 GOSUB 22000:GOSUB 24000
1060 GOSUB 25000
1070 IF DBG>0 THEN PRINT"Stack starts at ";FNHEXN$(SBM,4)
1080 OPEN"O",#1,EXF$:CLOSE#1:KILL EXF$
1090 NAME PLN$ AS EXF$
1110 IF DBG=0 THEN KILL PXN$
1120 GOSUB 26000
1130 END
12000 TRF=TRF+1:IF CO2<=PC.PI THEN 12100 ELSE REFRS[REF.INDX,0]=CO2:REFRS[REF.INDX,1]=AC.PI:IF DBG>0 THEN DBG$=" Fwd"+STR$(REF.INDX)+": PC"+STR$(REFRS[REF.INDX,0])
12010 REF.INDX=REF.INDX+1:RETURN
12100 GET#1,CO2+1:OUT.WORD=CVI(AC.PI$):IF DBG>0 THEN DBG$=" Bwd: PC"+STR$(CO2)+"= AC "+FNHEXN$(OUT.WORD,4)
12110 RETURN 
12200 LSET AC.PI$=MKI$(AC.PI):PUT#1,PC.PI+1:RETURN
12300 GET#3,PC.PI+1:CO1=CVI(CO1$):CO2=CVI(CO2$):Q1=CO1\256:Q2=CO1 MOD 256:RETURN
12400 IF DBG>0 THEN PRINT USING"&=#####: && ###_,######";FNHEXN$(AC.PI,4);PC.PI;OPCODE$[Q1 MOD 16];MID$("X ",2+(Q1\16<>0),1);Q2;CO2;:DBG$="":RETURN
12410 PRINT CHR$(13);PC.PI;:RETURN
12500 IF DBG>0 THEN PRINT DBG$
12600 LSET OUT.BYTE$=CHR$(OUT.BYTE):PUT#2,AC.PI-&H100+1:AC.PI=AC.PI+1:RETURN
12700 OUT.BYTE=FNLOW.BYTE(OUT.WORD):GOSUB 12600:OUT.BYTE=FNHIGH.BYTE(OUT.WORD):GOTO 12600
20000 DIM OPCODE$[8]:RESTORE 20000:FOR I=0 TO 8:READ OPCODE$[I]:NEXT:RETURN
20010 DATA LIT,OPR,LOD,STO,CAL,INT,JMP,JPC,CSP
21000 IF DBG>0 THEN PRINT"Reading RTS table"
21010 OPEN"R",#1,RTSFN$,RLN:FIELD#1,RLN AS RCRD$:GET#1,1:TBL.ADR=CVI(MID$(RCRD$,4,2))-&H100:TBL.RCN=FNRCN(TBL.ADR,RLN):TBL.OFS=FNOFS(TBL.ADR,RLN):IF TBL.OFS<>0 THEN PRINT"RTS info should start at offset 0, but offset is"TBL.OFS:STOP
21020 IF DBG>1 THEN PRINT"RTS info on page "FNHEXN$(TBL.RCN,2)
21030 GET#1,TBL.RCN+1:VN.MJ=FNBTV(RCRD$,1):VN.MN=FNBTV(RCRD$,2):VN.BF=FNBTV(RCRD$,3):PROGB=CVI(MID$(RCRD$,5,2)):TBL.LNADR=CVI(MID$(RCRD$,7,2))-&H100:INIT.LNADR=CVI(MID$(RCRD$,9,2))-&H100
21040 IF VN.MJ<>MJR OR VN.MN<MNR THEN PRINT"Incompatible RTS version!":STOP
21050 IF DBG>1 THEN PRINT"RTS version:"VN.MJ"."VN.MN"."VN.BF:PRINT"Translated P-code starts at "FNHEXN$(PROGB,4):PRINT"RTS table is at file address "FNHEXN$(TBL.LNADR,4):PRINT"INIT is at file address "FNHEXN$(INIT.LNADR,4)
21060 GET#1,FNRCN(TBL.LNADR,RLN)+1:TABLELEN=CVI(MID$(RCRD$,1,2))
21070 DIM PRTABLE[63]:FOR I=O TO TABLELEN-1:PRTABLE[I]=FNWDV(RCRD$,3+2*I):NEXT:IF DBG>1 THEN PRINT"RTS addresses:":FOR I=0 TO TABLELEN-1:PRINT I,FNHEXN$(PRTABLE[I],4):NEXT
21080 DIM P2R[8]:J=2*TABLELEN:FOR I=0 TO 8:P2R[I]=FNWDV(RCRD$,3+J+2*I):NEXT
21090 IF DBG>1 THEN FOR I=0 TO 8:PRINT OPCODE$[I],FNHEXN$(P2R[I],4):NEXT
21100 CLOSE#1
21110 IF DBG>0 THEN PRINT" Done reading RTS table"
21120 IF DBG>0 THEN PRINT"Copying RTS"
21130 OPEN"R",#1,RTSFN$,128:FIELD#1,128 AS SRC$:OPEN"R",#2,PLN$,128:FIELD#2,128 AS DST$
21140 N.BYTES=PROGB-&H100:N.PAGES=(N.BYTES+127)\128:IF DBG>1 THEN PRINT" Copying "N.BYTES"("HEX$(N.BYTES)") bytes = "N.PAGES" ("HEX$(N.PAGES)") pages"
21150 FOR I=1 TO N.PAGES:GET#1,I:LSET DST$=SRC$:PUT#2,I:IF DBG>1 THEN PRINT I;
21160 NEXT:IF DBG>1 THEN PRINT
21170 IF DBG>0 THEN PRINT" Done copying RTS"
21180 CLOSE #1,#2
21190 RETURN
22000 IF DBG>0 THEN PRINT"Translating"
22010 OPEN"R",#1,PXN$,2:FIELD#1,2 AS AC.PI$
22020 OPEN"R",#2,PLN$,1:FIELD#2,1 AS OUT.BYTE$:AC.PI=PROGB
22030 OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$,2 AS CO2$:PC.PI=0
22040 DIM REFRS[1000,1]:REF.INDX=0:TRF=0
22050 GOSUB 12300:WHILE NOT FNEO.PCFILE(CO1,CO2):GOSUB 12200:GOSUB 12400:GOSUB 23000:GOSUB 12500:PC.PI=PC.PI+1:GOSUB 12300:WEND:IF DBG=0 THEN PRINT
22060 SBM=AC.PI:MAX.PC.PI=PC.PI
22070 N.RFRS=REF.INDX
22080 IF DBG>0 THEN PRINT"Fixing"N.RFRS"references"
22090 FOR REF.INDX=0 TO N.RFRS-1:PC.ADRS=REFRS[REF.INDX,0]:AC.PI=REFRS[REF.INDX,1]:GET#1,PC.ADRS+1:OUT.WORD=CVI(AC.PI$)
22100 IF DBG>0 THEN IF DBG>1 THEN PRINT"Forward reference: P-code address is "FNHEXN$(PC.ADRS,4)" = "FNHEXN$(OUT.WORD,4)" @ "FNHEXN$(ADRS,4) ELSE PRINT REF.INDX+1;CHR$(13);
22110 GOSUB 12700:NEXT
22120 CLOSE#1,#2,#3
22130 IF DBG>0 THEN PRINT" Done translating and fixing references"
22140 RETURN
23000 ON (Q1 MOD 16)+1 GOTO 23100,23200,23300,23300,23400,23520,23610,23720,23810,23900,23900,23900,23900,23900,23900,23900
23010 REM: TRANSLATE:       LIT   OPR   LOD   STO   CAL   INT   JMP   JPC   CSP   ERR...
23100 REM:LIT 0,N: LXI B,N:CALL LIT
23110 OUT.BYTE=&H1:GOSUB 12600:OUT.WORD=CO2:GOSUB 12700
23120 OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]]:GOTO 12700
23200 REM OPR 0,N: CALL OPR00$NN, EXCEPT FOR OPR 0,0: JMP OPR00$00
23210 IF CO2=0 THEN OUT.BYTE=&HC3 ELSE OUT.BYTE=&HCD
23220 GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+CO2]:GOTO 12700
23300 REM: LOD(X) LVL, ADR   OR   STO(X) LVL,ADR) LVL,ADR
23310 PR.INDEX=P2R[Q1 MOD 16]
23320 REM                                         CALL LODA
23330 STAT.LVL=Q2:IF STAT.LVL=255 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[PR.INDEX-1]:GOTO 12700:'LOD 255,ADDR
23340 REM      MVI A, STAT.LVL                                LXI BC, ADDR
23350 OUT.BYTE=&H3E:GOSUB 12600:OUT.BYTE=STAT.LVL:GOSUB 12600:OUT.BYTE=&H1:GOSUB 12600:OUT.WORD=2*CO2:GOSUB 12700
23360 REM      CALL LOD, OR  CALL LODX
23370 OUT.BYTE=&HCD:GOSUB 12600:INDEXED=-(Q1>15):OUT.WORD=PRTABLE[PR.INDEX+2*INDEXED+1]:GOTO 12700
23400 REM:CAL LVL, PADDR
23410 STAT.LVL=Q2:IF STAT.LVL=255 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]-1]:GOTO 12700:REM CAL 255, ADDR
23420 REM: MVI A, LVL; CALL CAL:REMARK: THE CAL ROUTINE ONLY SETS UP THE PR STACK
23430 OUT.BYTE=&H3E:GOSUB 12600:OUT.BYTE=STAT.LVL:GOSUB 12600:OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+1]:GOSUB 12700
23440 REM       JMP ADDR
23450 OUT.BYTE=&HC3:GOSUB 12600:OUT.WORD=&HEFFE:GOSUB 12000:GOTO 12700
23500 REM INT 0, N
23510 REM        LXI H, 2*N                                          CALL INT
23520 IF CO2=0 THEN DBG$=" Q":RETURN ELSE OUT.BYTE=&H21:GOSUB 12600:OUT.WORD=CO2*2:GOSUB 12700:OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]]:GOTO 12700
23600 REM        JMP PADDR
23610 IF CO2=PC.PI+1 THEN DBG$=" Q":RETURN ELSE OUT.BYTE=&HC3:GOSUB 12600:OUT.WORD=0:GOSUB 12000:GOTO 12700
23700 REM JPC 0,PADDR OR JPC 1,PADDR
23710 REM      LDAX D          ;         DCX D           ;           DCX D         ;         RAR             ;             JNC           OR            JNC
23720 IF CO2=PC.PI+1 THEN DBG$=" Q":RETURN ELSE OUT.BYTE=&H1A:GOSUB 12600:OUT.BYTE=&H1B:GOSUB 12600:OUT.BYTE=&H1B:GOSUB 12600:OUT.BYTE=&H1F:GOSUB 12600:IF Q2=0 THEN OUT.BYTE=&HD2 ELSE OUT.BYTE=&HDA
23730 GOSUB 12600:OUT.WORD=0:GOSUB 12000:GOTO 12700
23800 REM CSP
23810 IF CO2<6 THEN OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=PRTABLE[P2R[Q1]+CO2]:GOTO 12700:REM CAL CSP
23820 IF CO2<>8 THEN PRINT"Error: unknown SP:";CO2:STOP
23830 REM: OUTPUT STRING
23840 SP8=PRTABLE[P2R[Q1]+CO2]:OLD.PC.PI=PC.PI:PC.PI=OLD.PC.PI-1:GOSUB 12300:STR.LEN=CO2:AC.PI=AC.PI-6*((STR.LEN+1)\2+1):OUT.BYTE=&H6:GOSUB 12600:OUT.BYTE=FNLOW.BYTE(STR.LEN):GOSUB 12600
23850 REM:       CALL SP8;                                                                                                     DB STRING[0], STRING[1], ...
23860 OUT.BYTE=&HCD:GOSUB 12600:OUT.WORD=SP8:GOSUB 12700:STR.BASE=OLD.PC.PI-(STR.LEN+1)\2-2
23870 FOR I=1 TO STR.LEN\2:PC.PI=STR.BASE+I:GOSUB 12300:OUT.BYTE=FNLOW.BYTE(CO2):GOSUB 12600:OUT.BYTE=FNHIGH.BYTE(CO2):GOSUB 12600:NEXT:IF STR.LEN MOD 2=1 THEN PC.PI=STR.BASE+(STR.LEN+1)\2:GOSUB 12300:OUT.BYTE=FNLOW.BYTE(CO2):GOSUB 12600
23880 PC.PI=OLD.PC.PI:RETURN
23900 PRINT"Illegal P-code":STOP
24000 IF DBG>0 THEN PRINT"Patching INIT"
24010 OPEN"R",#1,RTSFN$,RLN:FIELD#1,RLN AS RCRD$:OPEN"R",#2,PLN$,RLN:FIELD#2,RLN AS AC$
24020 GET#1,FNRCN(INIT.LNADR,RLN)+1:PAGENUM=FNRCN(SBM-&H100,RLN):GET#2,PAGENUM+1
24030 INIT.LEN=FNWDV(RCRD$,1):IF DBG>1 THEN PRINT"INIT is "INIT.LEN" bytes"
24040 MID$(RCRD$,4)=MKI$(SBM)
24050 MOVED=0:AC.START=FNOFS(SBM,RLN):IF DBG>1 THEN PRINT"Moving INIT to page "FNHEXN$(PAGENUM,2)", offset "FNHEXN$(AC.START,2)
24060 WHILE MOVED<INIT.LEN:TOMOVE=FNMIN(RLN-AC.START,INIT.LEN-MOVED):MID$(AC$,AC.START+1)=MID$(RCRD$,3+MOVED,TOMOVE):PUT#2,PAGENUM+1:MOVED=MOVED+TOMOVE:PAGENUM=PAGENUM+1:GET#2,PAGENUM+1:AC.START=0
24070 IF DBG>1 THEN PRINT"Moved "MOVED" bytes"
24080 WEND
24090 GET#2,1:MID$(AC$,2)=MKI$(SBM):PUT#2,1
24100 IF DBG>0 THEN PRINT" Done patching INIT"
24110 CLOSE#1,#2
24120 RETURN
25000 IF DBG>O THEN PRINT"Listing P-codes and addresses"
25010 OPEN"O",#2,PAL$
25020 GOSUB 25500
25030 IF DBG>0 THEN PRINT" Done listing P-codes and addresses"
25040 RETURN
25500 OPEN"R",#3,PFN$,4:FIELD#3,2 AS CO1$,2 AS CO2$
25510 OPEN"R",#1,PXN$,2:FIELD#1,2 AS AC.PI$
25520 R=3:L=MAX.PC.PI:N=L\R-((L MOD R)<>0)
25530 FOR I=0 TO N-1:FOR J=0 TO R-1:PC.PI=I+J*N
25540 IF PC.PI>=L THEN 25570
25550 GOSUB 12300:GET#1,PC.PI+1:AC.PI=CVI(AC.PI$):IF Q1>15 THEN IDX$="X" ELSE IDX$=" "
25560 PRINT#2,USING"#####=\  \:\ \! ###_,######";PC.PI;FNHEXN$(AC.PI,4);OPCODE$[Q1 MOD 16];IDX$;Q2;CO2;
25570 NEXT J:PRINT#2,:NEXT I
25580 PRINT#2,"Stack starts at ";FNHEXN$(SBM,4)
25590 CLOSE#1,#2,#3
25600 RETURN
26000 PRINT CHR$(13);"P-Code : 8080-code = ";4*MAX.PC.PI;":"; SBM-PROGB;" = 1 :";(SBM-PROGB)/(4*MAX.PC.PI);"."
26010 IF TRF=0 THEN PRINT"No references."ELSE PRINT TRF;"references,"; N.RFRS; "forward,";TRF-N.RFRS;"backward: 1 forward per";MAX.PC.PI/N.RFRS;"P-code instructions."
26020 RETURN
