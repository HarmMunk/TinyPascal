

                ; PASCAL RUN-TIME ROUTINES
                ; BY H. YUEN
                ; VERSION 3.0 MAY/JULY 2012 BY H. MUNK
                
                ; CP/M EQUATES
                
 0005 =         BDOS	EQU		0005H
                
                ; CP/M DOS FUNCTIONS
 0000 =         B$SYSRESET	EQU	0	; SYSTEM RESET
 0001 =         B$CONIN		EQU	1	; CONSOLE INPUT
 0002 =         B$CONOUT	EQU	2	; CONSOLE OUTPUT
                
 0007 =         B$TOPRAM	EQU	7	; MSB OF ADDRESS OF START OF BDOS
                
 000D =         CR		EQU	13
 000A =         LF		EQU	10
                
                ; INVARIANTS
                ; VALUES ON THE STACK ARE STORED BIG ENDIAN (HIGH BYTE AT LOW ADDRESS)
                ; DE CONTAINS TOP-OF-STACK AND POINTS TO THE LSBYTE OF THE TOP VALUE
                ; BB CONTAINS BASE ADDRESS AND POINTS TO THE LSBYTE OF THE LOWEST WORD
                ; OF THE STACK FRAME:
                ;	+-----------------------+
                ;	| LSBYTE VARIABLE 2     |	<== DE (STACK POINTER)
                ;	+-----------------------+
                ;	| MSBYTE VARIABLE 2     |
                ;	+-----------------------+
                ;	| LSBYTE VARIABLE 1     |
                ;	+-----------------------+
                ;	| MSBYTE VARIABLE 1     |
                ;	+-----------------------+
                ;	| LSBYTE RETURN ADDRESS |
                ;	+-----------------------+
                ;	| MSBYTE RETURN ADDRESS |
                ;	+-----------------------+
                ;	| LSBYTE DYNAMIC LINK   |
                ;	+-----------------------+
                ;	| MSBYTE DYNAMIC LINK   |
                ;	+-----------------------+
                ;	| LSBYTE STATIC LINK    |	<== BB (BASE POINTER)
                ;	+-----------------------+
                ;	| MSBYTE STATIC LINK    |
                ;	+-----------------------+
                ;	| LSBYTE PARAMETER N    |
                ;	+-----------------------+
                ;	| MSBYTE PARAMETERN     |
                ;	+-----------------------+
                ;	| LSBYTE PARAMETER      |
                ;	+-----------------------+
                ;	| MSBYTE PARAMETER      |
                ;	+-----------------------+
                ;
                
 0100           	ORG	100H
                ; AS THIS IS THE FIRST INSTRUCTION EXECUTED AFTER LOADING BY CP/M, IT
                ; MUST CONTAIN A JUMP TO THE FIRST INSTRUCTION OF THE PROGRAM
                
 0100 C30207    	JMP	INIT
                
                ; STORAGE
 0103 0006      BB:	DW	RTS$INFO	; BASE REGISTER. THIS LOCATION IS 
                				; FILLED WITH THE START ADDRESS OF THE 
                				; INFORMATION BLOCK OF THE TINY PASCAL 
                				; RUNTIME SYSTEM. THAT INFORMATION BLOCK 
                				; IS USED BY THE P-CODE TO 
                				; 8080-TRANSLATOR.
 0105 0000      STACK2:	DW	0		; COMPLEMENT OF STACK TOPMOST ADDRESS
                
                
                ; OPR 0,0	: PROCEDURE OR FUNCTION RETURN
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$00:
 0107 2A0301    	LHLD	BB		; GET CURRENT BASE ADDRESS
 010A 23        	INX	H		; POINT TO DYNAMIC LINK
 010B 56        	MOV	D,M		; LOAD DYNAMIC LINK IN DE
 010C 23        	INX	H
 010D 5E        	MOV	E,M
 010E EB        	XCHG
 010F 220301    	SHLD	BB		; SAVE DYNAMIC LINK AS NEW BASE ADDRESS
 0112 EB        	XCHG
 0113 23        	INX	H		; LOAD RETURN ADDRESS IN DE
 0114 56        	MOV	D,M
 0115 23        	INX	H
 0116 5E        	MOV	E,M
 0117 01FAFF    	LXI	B,-6
 011A 09        	DAD	B		; DECREMENT STACK POINTER BY THREE WORDS
 011B EB        	XCHG			; STACK POINTER TO DE, RETURN ADDRESS TO HL
 011C E9        	PCHL
                
                ; OPR 0,1	: [SP] := -[SP] : NEGATE TOP OF STACK ELEMENT
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$01:
 011D EB        	XCHG			; STACK POINTER TO HL
 011E AF        	XRA	A		; CLEAR A
 011F 96        	SUB	M		; A = -LBYTE
 0120 77        	MOV	M,A		; PUT BACK
 0121 4F        	MOV	C,A		; C = -LBYTE
 0122 2B        	DCX	H		; POINT TO HIGH ORDER BYTE
 0123 9E        	SBB	M		; A = -LBYTE - HBYTE
 0124 91        	SUB	C		; A = -LBYTE - HBYTE - (-LBYTE) = -HBYTE
 0125 77        	MOV	M,A		; PUT BACK
 0126 23        	INX	H		; REPAIR STACK POINTER
 0127 EB        	XCHG			; STACK POINTER TO DE
 0128 C9        	RET
                
                ; OPR 0,2	: [SP-1] := [SP-1] + [SP]
                ; 8080 STACK USAGE: 2+#'PPOP' BYTES
                OPR00$02:
 0129 CD8E04    	CALL	PPOP		; POP TOP TWO ELEMENTS
 012C C3BA03    	JMP	ADD16		; DO THE 16 ADDITION, PUSH RESULT ON STACK,
                				; RETURN THERE
                
                ; OPR 0,3	: [SP-1] := [SP-1] - [SP]
                ; 8080 STACK USAGE:  2+#'PPOP' BYTES
                OPR00$03:
 012F CD8E04    	CALL	PPOP		; POP TOP TWO ELEMENTS
 0132 78        	MOV	A,B		; GET MSB IN A
 0133 D680      	SUI	80H		; SUBTRACT -128(*256)
 0135 B1        	ORA	C		; IS BC == -32768
 0136 C2B703    	JNZ	SUB1		; NO, DO THE SUBTRACT
 0139 79        	MOV	A,C		; -(-32768) GIVES OVERFLOW
 013A C3BB03    	JMP	SU2
                
                ; OPR 0,4	: [SP-1] := [SP-1] * [SP]
                ; 8080 STACK USAGE:  MAX(2+#'PPOP', PPUSH) BYTES
                OPR00$04:
 013D CD8E04    	CALL PPOP		; POP TOP TWO ELEMENTS
 0140 D5        	PUSH	D		; SAVE STACK POINTER
 0141 7C        	MOV	A,H		; GET HIGH BYTE OF [SP-1]
 0142 5D        	MOV	E,L		; SAVE LOW BYTE [SP-1]
 0143 210000    	LXI	H,0		; CLEAR RESULT
 0146 B7        	ORA	A		; SEE IF MSB [SP-1] IS ZERO
 0147 C4C703    	CNZ	MUL8
 014A 7B        	MOV	A,E
 014B CDC703    	CALL	MUL8
 014E D1        	POP	D		; RESTORE STACK POINTER
 014F C3A004    	JMP	PPUSH		; PUSH RESULT, RETURN THERE
                
                ; OPR 0,5	: [SP-1] := [SP-1] / [SP]
                ; 8080 STACK USAGE: MAX(2+MAX(2+#'PPOP', 2+#'DIV16'), 'PPUSH') BYTES
                OPR00$05:
 0152 CD8E04    	CALL PPOP		; POP TOP TWO ELEMENTS
 0155 D5        	PUSH	D		; SAVE STACK POINTER
 0156 CDD403    	CALL	DIV16		; DO THE DIVIDE
 0159 D1        	POP	D		; RESTORE STACK POINTER
 015A C3A004    	JMP	PPUSH		; GO PUSH RESULT, RETURN THERE
                
                ; OPR 0,6	: [SP-1] := ODD([SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$06:
 015D 1A        	LDAX	D		; GET LSB
 015E E601      	ANI	1		; TEST BIT 0
 0160 12        	STAX	D		; SAVE LSB OF RESULT
 0161 1B        	DCX	D		; POINT TO MSB
 0162 AF        	XRA	A		; CLEAR A
 0163 12        	STAX	D		; SAVE MSB OF RESULT
 0164 13        	INX	D		; ADJUST STACK POINTER
 0165 C9        	RET
                
                ; OPR 0,7	: [SP-1] := [SP-1] MOD [SP]
                ; 8080 STACK USAGE: MAX(2+MAX(2+#'PPOP', 2+2+#'DIV16'), #'PPUSH') BYTES
                OPR00$07:
 0166 CD8E04    	CALL PPOP		; POP TOP TWO ELEMENTS
 0169 D5        	PUSH	D		; SAVE STACK POINTER
 016A CDD403    	CALL	DIV16		; DO THE DIVIDE
 016D EB        	XCHG			; FLIP REMAINDER TO HL
 016E D1        	POP	D		; RESTORE STACK POINTER
 016F C3A004    	JMP	PPUSH		; GO PUSH RESULT, RETURN THERE
                
                ; OPR 0,8	: [SP-1] := ([SP-1] = [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$08:
 0172 3E01      	MVI	A,1		; LOAD FLAGS
 0174 C31B04    	JMP	EQUAL		; GO TEST
                
                ; OPR 0,9	: [SP-1] := ([SP-1] <> [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$09:
 0177 AF        	XRA	A		; LOAD FLAGS
 0178 C31B04    	JMP	EQUAL		; GO TEST
                
                ; OPR 0,10	: [SP-1] := ([SP-1] < [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$0A:
 017B 010001    	LXI	B,0100H		; LOAD FLAGS
 017E C33504    		JMP LESS	; GO TEST
                
                ; OPR 0,11	: [SP-1] := ([SP-1] >= [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$0B:
 0181 010000    	LXI	B,0000H		; LOAD FLAGS
 0184 C33504    		JMP LESS	; GO TEST
                
                ; OPR 0,12	: [SP-1] := ([SP-1] > [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$0C:
 0187 010100    	LXI	B,0001H		; LOAD FLAGS
 018A C33504    		JMP LESS	; GO TEST
                
                ; OPR 0,13	: [SP-1] := ([SP-1] < [SP])
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$0D:
 018D 010101    	LXI	B,0101H		; LOAD FLAGS
 0190 C33504    		JMP LESS	; GO TEST
                
                ; OPR 0,14	: [SP-1] := [SP-1] OR [SP]
                ; 8080 STACK USAGE: 2+#'PPOP' BYTES
                OPR00$0E:
 0193 CD8E04    	CALL PPOP		; POP TOP TWO ELEMENTS
 0196 7C        	MOV	A,H		; 'OR' HIGH ORDER BYTES
 0197 B0        	ORA	B
 0198 13        	INX	D
 0199 12        	STAX	D		; PUSH RESULT
 019A 7D        	MOV	A,L		; 'OR' LOW ORDER BYTES
 019B B1        	ORA	C
 019C 13        	INX	D
 019D 12        	STAX	D		; PUSH RESULT
 019E C9        	RET
                
                ; OPR 0,15	: [SP-1] := [SP-1] AND [SP]
                ; 8080 STACK USAGE: 2+#'PPOP' BYTES
                OPR00$0F:
 019F CD8E04    	CALL PPOP		; POP TOP TWO ELEMENTS
 01A2 7C        	MOV	A,H		; 'OR' HIGH ORDER BYTES
 01A3 A0        	ANA	B
 01A4 13        	INX	D
 01A5 12        	STAX	D		; PUSH RESULT
 01A6 7D        	MOV	A,L		; 'OR' LOW ORDER BYTES
 01A7 A1        	ANA	C
 01A8 13        	INX	D
 01A9 12        	STAX	D		; PUSH RESULT
 01AA C9        	RET
                
                ; OPR 0,16	: [SP] := COMPLEMENT [SP]
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$10:
 01AB 1A        	LDAX	D		; GET LOW ORDER BYTE
 01AC 2F        	CMA			; COMPLEMENT
 01AD 12        	STAX	D		; SAVE
 01AE 1B        	DCX	D
 01AF 1A        	LDAX	D		; GET HIGH ORDER BYTE
 01B0 2F        	CMA			; COMPLEMENT
 01B1 12        	STAX	D		; SAVE
 01B2 13        	INX	D		; REPAIR STACK POINTER
 01B3 C9        	RET
                
                ; OPR 0,17	: [SP-1] := [SP-1] SHL [SP]
                ; 8080 STACK USAGE: MAX(2+MAX(#'PPOP'), #'PPUSH',#'OPR00$12$1',#'OPR00$11$1') BYTES
                OPR00$11:
 01B4 CD8E04    	CALL	PPOP		; POP TOP TWO ELEMENTS
 01B7 AF        	XRA	A		; CLEAR A
 01B8 81        	ADD	C		; GET C, SET FLAGS
 01B9 CAA004    	JZ	PPUSH		; DO NOTHING IF ZERO
 01BC FAD301    	JM	OPR00$12$1		; SHIFT RIGH IF <0
                OPR00$11$1:
 01BF 29        	DAD	H		; SHIFT LEFT ONE PLACE
 01C0 3D        	DCR	A
 01C1 C2BF01    	JNZ	OPR00$11$1	; LOOP FOR ALL
 01C4 C3A004    	JMP	PPUSH		; GO PUSH RESULT, RETURN THERE
                
                ; OPR 0,18	: [SP-1] := [SP-1] SHR [SP]
                ; 8080 STACK USAGE: MAX(2+MAX(#'PPOP'), #'PPUSH',#'OPR00$12$1',#'OPR00$11$1') BYTES
                OPR00$12:
 01C7 CD8E04    	CALL	PPOP		; POP TOP TWO ELEMENTS
 01CA AF        	XRA	A		; CLEAR A
 01CB 91        	SUB	C		; NEGATE C, SET FLAGS
 01CC CAA004    	JZ	PPUSH		; DO NOTHING IF ZERO
 01CF F2BF01    	JP	OPR00$11$1	; SHIFT RIGHT IF >0
 01D2 4F        	MOV	C,A		; -COUNT IN C
                OPR00$12$1:
 01D3 AF        	XRA	A
 01D4 B4        	ORA	H		; GET H, RESET CARRY
 01D5 1F        	RAR			; SHIFT RIGHT
 01D6 67        	MOV	H,A		; SAVE RESULT
 01D7 7D        	MOV	A,L
 01D8 1F        	RAR			; MOVE CARRY IN
 01D9 6F        	MOV	L,A
 01DA 0C        	INR	C		; COUNT UP TO 0
 01DB C2D301    	JNZ	OPR00$12$1	; LOOP FOR ALL
 01DE C3A004    	JMP	PPUSH		; GO PUSH RESULT, RETURN THERE
                
                ; OPR 0,19	: [SP] := [SP] + 1
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$13:
 01E1 1A        	LDAX	D		; GET LOW ORDER BYTE
 01E2 C601      	ADI	1		; INCREMENT
 01E4 12        	STAX	D		; SAVE INCREMENTED LOW ORDER BYTE
 01E5 D0        	RNC			; DONE IF NO CARRY
 01E6 62        	MOV	H,D		; COPY STACK POINTER IN HL
 01E7 6B        	MOV	L,E
 01E8 2B        	DCX	H		; POINT TO HIGH ORDER BYTE
 01E9 34        	INR	M		; INCREMENT HIGH ORDER BYTE
 01EA C9        	RET
                
                ; OPR 0,20	: [SP] := [SP] - 1
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$14:
 01EB 1A        	LDAX	D		; GET LOW ORDER BYTE
 01EC D601      	SUI	1		; DECCREMENT
 01EE 12        	STAX	D		; SAVE INCREMENTED LOW ORDER BYTE
 01EF D0        	RNC			; DONE IF NO CARRY
 01F0 62        	MOV	H,D		; COPY STACK POINTER IN HL
 01F1 6B        	MOV	L,E
 01F2 2B        	DCX	H		; POINT TO HIGH ORDER BYTE
 01F3 35        	DCR	M		; INCREMENT HIGH ORDER BYTE
 01F4 C9        	RET
                
                ; OPR 0,21	: [SP+1] := [SP]
                ; 8080 STACK USAGE: 0 BYTES
                OPR00$15:
 01F5 62        	MOV	H,D		; COPY STACK POINTER IN HL
 01F6 6B        	MOV	L,E
 01F7 13        	INX	D		; POINT TO NEXT STACK ELEMENT
 01F8 2B        	DCX	H		; POINT TO LSB OF CURRENT STACK ELEMENT
 01F9 7E        	MOV	A,M		; GET BYTE
 01FA 12        	STAX	D		; COPY
 01FB 23        	INX	H
 01FC 13        	INX	D		; BOTH POINTERS TO NEXT BYTE
 01FD 7E        	MOV	A,M		; GET BYTE
 01FE 12        	STAX	D		; COPY
 01FF C9        	RET
                
                ; OPR 0,22	: [SP-1] := BDOS([SP-1], [SP])
                ; 8080 STACK USAGE: 4 BYTES
                OPR00$16:
 0200 CD8E04    	CALL	PPOP		; POP [SP] IN BC, [SP-1] IN HL
 0203 D5        	PUSH	D		; SAVE MY SP
 0204 59        	MOV	E,C		; MOVE ARGUMENT TO BDOS...
 0205 50        	MOV	D,B		; ...TO DE
 0206 4D        	MOV	C,L		; MOVE BDOS FUNCTION NUMBER TO C
 0207 CD0500    	CALL	BDOS		; DO THE BDOS FUNCTION
 020A D1        	POP	D		; POP MY STACK POINTER
 020B C3A004    	JMP	PPUSH		; PUSH RETURNED VALUE IN HL ON MY STACK, RETURN THERE
                
                ; OPR 0, 23	: [SP] := -(STACK2+[SP]); STACK := STACK2+[SP]
                ; 8080 STACK USAGE: 4 BYTES
                OPR00$17:
 020E CD9904    	CALL 	POP1		; POP TOP ELEMENT TO HL: DELTA TO DECREASE STACK SPACE WITH
 0211 D5        	PUSH	D		; SAVE SP
 0212 EB        	XCHG			; DELTA TO DE
 0213 2A0501    	LHLD	STACK2		; GET COMPLEMENT OF CURRENT STACK TOP IN HL
 0216 19        	DAD	D		; ADD DELTA: HL = -(STACKTOP-DELTA)
 0217 D1        	POP	D		; GET SP BACK
 0218 D5        	PUSH	D		; DON'T SAVE JUST YET
 0219 E5        	PUSH	H		; SAVE NEW COMPLEMENT OF STACK SPACE END
 021A 19        	DAD	D		; CHECK IF SUFFICIENT STACK SPACE LEFT
 021B E1        	POP	H		; GET NEW COMPLEMENT OF STACK SPACE END BACK
 021C D1        	POP	D		; RESTORE STACK
 021D DAAE03    	JC	STKOV		; JUMP ON OUT OF STACK SPACE
 0220 220501    	SHLD	STACK2		; SAVE NEW COMPLEMENT OF STACK SPACE END
 0223 CD5F04    	CALL	NEGH		; FORM ADDRESS OF STACK TOP
 0226 C3A004    	JMP	PPUSH		; STORE ON STACK
                	
                ; SP0		: INPUT A CHARACTER
                ; 8080 STACK USAGE: 2+#'INP' BYTES
 0229 13        SP0:	INX	D
 022A AF        	XRA	A
 022B 12        	STAX	D		; CLEAR HIGH ORDER BYTE
 022C 13        	INX	D		; POINT TO LOW ORDER BYTE
 022D CDB204    	CALL	INP		; GET A CHARACTER
 0230 12        	STAX	D		; PUSH ON STACK
 0231 C9        	RET
                
                ; SP 1		: OUTPUT A CHARACTER
                ; 8080 STACK USAGE: #'OUTP' BYTES
 0232 1A        SP1:	LDAX	D		; POP CHARACTER
 0233 1B        	DCX	D		; DECREMENT STACK POINTER
 0234 1B        	DCX	D
 0235 C3BE04    	JMP	OUTP		; GO OUTPUT, RETURN THERE
                
                ; SP 2		: INPUT A DECIMAL NUMBER
                ; 8080 STACK USAGE: MAX(2+2+MAX(#'OUTP', #'INP'), #'PPUSH') BYTES
 0238 D5        SP2:	PUSH	D		; SAVE STACK POINTER
 0239 3E3F      SP2$1:	MVI	A,'?'		; PRINT A '?' PROMPT
 023B 57        	MOV	D,A		; SET INIT FLAG
 023C CDBE04    	CALL	OUTP
 023F AF        	XRA	A		; CLEAR SIGN
 0240 325E05    	STA	SIGN
 0243 67        	MOV	H,A		; CLEAR RESULT
 0244 6F        	MOV	L,A
 0245 CDB204    SP2$2:	CALL INP		; GET A CHARACTER
 0248 FE20      	CPI	' '		; IGNORE SPACES
 024A CA4502    	JZ	SP2$2
 024D FE2B      	CPI	'+'		; PLUS?
 024F CA5A02    	JZ	SP2$3		; IGNORE PLUS
 0252 FE2D      	CPI	'-'		; MINUS?
 0254 C25D02    	JNZ	SP2$4		; JUMP IF NOT MINUS
 0257 325E05    	STA	SIGN		; SAVE SIGN
 025A CDB204    SP2$3:	CALL	INP		; STEP OVER '+' OR '-'
 025D D630      SP2$4:	SUI	'0'		; CONVERT ASCII TO BINARY
 025F FA8302    	JM	SP2$6		; JUMP IF NOT A DIGIT
 0262 FE0A      	CPI	10		; MUST BE IN RANGE 0 .. 9
 0264 F28302    	JP	SP2$6		; JUMP IF NOT A DIGIT
 0267 5F        	MOV	E,A		; MOVE TO DE
 0268 AF        	XRA	A		; CLEAR INIT FLAG
 0269 57        	MOV	D,A
 026A 29        	DAD	H		; RESULT*2
 026B 8F        	ADC	A		; CATCH OVERFLOW IN A
 026C 44        	MOV	B,H		; COPY IN BC
 026D 4D        	MOV	C,L
 026E 29        	DAD	H		; RESULT*4
 026F 8F        	ADC	A		; CATCH OVERFLOW IN A
 0270 29        	DAD	H		; RESULT*8
 0271 8F        	ADC	A		; CATCH OVERFLOW IN A
 0272 09        	DAD	B
 0273 8F        	ADC	A		; CATCH OVERFLOW IN A
 0274 19        	DAD	D		; ADD DIGIT
 0275 8F        	ADC	A		; CATCH OVERFLOW IN A
 0276 C27D02    	JNZ	SP2$5		; JUMP IF OVERFLOW
 0279 B4        	ORA	H		; A IS ZERO, TEST MSB
 027A F25A02    	JP	SP2$3		; GO FOR NEXT DIGIT
 027D 212A05    SP2$5:	LXI	H,MER2		; GET ERROR MESSAGE
 0280 C39702    	JMP	SP2$8		; GO PRINT, TRY AGAIN
                
 0283 AF        SP2$6:	XRA	A		; TEST INIT FLAG
 0284 82        	ADD	D 	
 0285 C29402    	JNZ	SP2$7		; ERROR IF NO DIGITS
 0288 3A5E05    	LDA	SIGN		; TEST SIGN
 028B B7        	ORA	A
 028C C45F04    	CNZ	NEGH		; NEGATE HL IF SET
 028F D1        	POP	D		; RESTORE STACK POINTER
 0290 13        	INX	D		; POINT TO HIGH ORDER BYTE
 0291 C3A004    	JMP	PPUSH		; GO PUSH NUMBER, RETURN THERE
                
 0294 211B05    SP2$7:	LXI	H,MER1		; LOAD ERROR MESSAGE
 0297 CD0C05    SP2$8:	CALL	PRINT		; PRINT ERROR MESSAGE
 029A C33902    	JMP	SP2$1		; TRY AGAIN
                
                ; SP3		: OUTPUT [SP] DECIMAL
                ; 8080 STACK USAGE: MAX(2+#'PPOP',2+2+#'NEGH',4+2+MAX(#'DIV16',#'OUTP'))
 029D CD9904    SP3:	CALL	POP1		; POP TOP OF STACK IN HL
 02A0 D5        	PUSH	D		; SAVE STACK POINTER
 02A1 0E20      	MVI	C,' '		; DEFAULT SIGN CHARACTER
 02A3 AF        	XRA	A		; TEST SIGN
 02A4 B4        	ORA	H
 02A5 F2AD02    	JP	SP3$1		; SKIP IF POSITIVE
 02A8 0E2D      	MVI	C,'-'		; SIGN CHARACTER
 02AA CD5F04    	CALL	NEGH		; NEGATE HL
 02AD 0600      SP3$1:	MVI	B,0		; CLEAR CHARACTER COUNT
 02AF C5        SP3$2:	PUSH	B		; SAVE NUMBER OF CHARACTERS AND SIGN
 02B0 010A00    	LXI	B,10		; DIVIDE BY 10
 02B3 CDD403    	CALL	DIV16
 02B6 C1        	POP	B		; RESTORE NUMBER OF CHARACTERS AND SIGN
 02B7 3E30      	MVI	A,'0'		; CONVERT TO ASCII
 02B9 83        	ADD	E
 02BA F5        	PUSH	PSW		; SAVE CHARACTER ON STACK
 02BB 04        	INR	B		; UPDATE NUMBER OF CHARACTERS
 02BC 7C        	MOV	A,H		; SEE IF 0 REMAINS
 02BD B5        	ORA	L
 02BE C2AF02    	JNZ	SP3$2		; JUMP IF NOT 0
 02C1 79        	MOV	A,C		; GET SIGN
 02C2 CDBE04    	CALL	OUTP		; PRINT SIGN
 02C5 F1        SP3$4:	POP	PSW		; POP A DIGIT
 02C6 CDBE04    	CALL	OUTP		; PRINT IT
 02C9 05        	DCR	B
 02CA C2C502    	JNZ	SP3$4		; LOOP FOR ALL DIGITS
