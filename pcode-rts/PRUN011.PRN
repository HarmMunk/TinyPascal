 04D0 D8        	RC
 04D1 07        	RLC			; MOVE TO MS NIBBLE
 04D2 07        	RLC
 04D3 07        	RLC
 04D4 07        	RLC
 04D5 4F        	MOV	C,A		; SAVE RESULT
                
                ; INPUT ONE HEX DIGIT
                ; 8080 STACK USAGE: 2+MAX(#'INP',#'PRINT')
 04D6 CDB204    IHX:	CALL	INP		; GET A CHARACTER
 04D9 D630      	SUI	'0'		; MAKE VALUE FROM CHARACTER
 04DB DAEB04    	JC	IHX$1		; REPORT INPUT ERROR IF LESS THAN '0'
 04DE FE0A      	CPI	10		; IS VALUE LARGER THAN 10?
 04E0 3F        	CMC			; MAKE SURE THE CY HAS THE RIGHT VALUE
 04E1 D0        	RNC			; OK (AND NO CY) IF LESS THAN 10
 04E2 D607      	SUI	'A'-'9'-1	; SEE IF IN 'A'-'F'
 04E4 DAEB04    	JC	IHX$1		; IF LESS THAN 'A', REPORT ERROR
 04E7 FE10      	CPI	16		; IS VALUE LARGER THAN 16?
 04E9 3F        	CMC			; MAKE SURE THE CY HAS THE RIGHT VALUE
 04EA D0        	RNC			; OK (AND NO CY) IF LESS THAN 10
 04EB 211B05    IHX$1:	LXI	H,MER1		; LOAD ERROR MESSAGE
 04EE CD0C05    	CALL	PRINT		; PRINT ERROR MESSAGE
 04F1 37        	STC			; SET CY AS ERROR FLAG
 04F2 C9        	RET
                
                ; PRINT TWO HEX DIGITS, VALUE IN A
                ; 8080 STACK USAGE: MAX(2+#'HEX$1', #'OUTP') BYTES
 04F3 4F        HEX:	MOV	C,A		; SAVE VALUE
 04F4 E6F0      	ANI	11110000B	; MASK OFF MS NIBBLE
 04F6 0F        	RRC			; MOVE TO LS NIBBLE
 04F7 0F        	RRC
 04F8 0F        	RRC
 04F9 0F        	RRC	
 04FA CD0005    	CALL	HEX$1
 04FD 79        	MOV	A,C		; GET VALUE BACK
 04FE E60F      	ANI	00001111B	; MASK OFF LS NIBBLE
 0500 FE0A      HEX$1:	CPI	10		; MORE THAN 10?
 0502 FA0705    	JM	HEX$2		; JUMP IF LESS THAN 10
 0505 C607      	ADI	'A'-'9'-1	; FIRST STAGE IN CONVERTING VALUE TO CHARACTER
 0507 C630      HEX$2:	ADI	'0'		; CONVERT TO CHARACTER
 0509 C3BE04    	JMP	OUTP		; PRINT VALUE, RETURN THERE
                
                ; PRINT AN ERROR MESSAGE
                ; 8080 STACK USAGE: 2+#'OUTPUT'
 050C 7E        PRINT:	MOV	A,M
 050D B7        	ORA	A
 050E C8        	RZ
 050F 23        	INX	H
 0510 CDBE04    	CALL	OUTP
 0513 C30C05    	JMP	PRINT
                
 0516 0E00      EXIT:	MVI	C,B$SYSRESET
 0518 C30500    	JMP	BDOS
                
                ; MESSAGES
 051B 20494E5055MER1:	DB	' INPUT ERROR', CR, LF, 0
 052A 2053495A45MER2:	DB	' SIZE ERROR', CR, LF, 0
 0538 2053544143STVMSG:	DB	' STACK'
 053E 204F564552OVFMSG:	DB	' OVERFLOW', CR, LF, 0
 054A 2044495649DV0MSG:	DB	' DIVISION BY ZERO', CR, LF, 0
                
                ; STORAGE
                
 055E 20        SIGN:	DB	' '		; SIGN FLAG BYTE
                
                PRIVATE$STACK:
 055F DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 0563 DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 0567 DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 056B DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 056F DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 0573 DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 0577 DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
 057B DEADBEEF  	DB	0DEH, 0ADH, 0BEH, 0EFH
                
                ; END OF TINY PASCAL RUN TIME ROUTINES, BEGIN OF TRANSLATED P-CODE
 057F 218805    PROGB:	LXI 	H,NOPCD$MSG
 0582 CD0C05    	CALL	PRINT
 0585 C31605    	JMP	EXIT
                NOPCD$MSG:
 0588 54696E7920	DB	'Tiny Pascal Run Time System: no translated P-code!', CR, LF, 0
                
                ; THE FOLLOWING SECTION CONTAINS A TABLE WITH THE ADDRESSES
                ; OF ALL RELEVANT P-CODE ROUTINES
                ; THE P-CODE-TO-8080 TRANSLATOR USES THE ADDRESSES FROM THIS TABLE. IT FINDS THE TABE THROUGH THE ASSEMB
                ; THE TABLE WILL NOT SHOW UP IN THE TRANSLATED FILE
                ; THIS TABLE MAKES THE TRANSLATOR RUN-TIME ROUTINE POSITION INDEPENDENT
                
                ; ENSURE THE NEXT TABLE STARTS ON A PAGE BOUNDARY
 0600           	ORG	($ + 0FFH) AND 0FF00H
                
                RTS$INFO:
 0600 00010100  	DB	0,1,1,0		; MAJOR, MINOR, BUG FIX VERSION, PADDING BYTE
 0604 7F05      	DW	PROGB
 0606 8006      	DW	TABLE$LEN
 0608 0007      	DW	INIT$LEN
 060A A903      	DW	STACK$CHK
                
 0680           	ORG	($+07FH) AND 0FF80H
                TABLE$LEN:
 0680 3000      	DW	(TABLE$END-TABLE$START)/2
                TABLE$START:
 0000 =         LIT$IX	EQU	($-TABLE$START)/2
 0682 0703      	DW	LIT
 0001 =         INT$IX	EQU	($-TABLE$START)/2
 0684 A703      	DW	INT
                
 0686 1003      	DW	LODA
 0003 =         LOD$IX	EQU	($-TABLE$START)/2
 0688 1D03      	DW	LOD
 068A 1E03      	DW	LOD1
 068C 3103      	DW	LODX
 068E 3203      	DW	LODX1
                
 0690 4B03      	DW	STOA
 0008 =         STO$IX	EQU	($-TABLE$START)/2
 0692 5303      	DW	STO
 0694 5403      	DW	STO1
 0696 6403      	DW	STOX
 0698 6503      	DW	STOX1
                
 069A 8103      	DW	CALA
 000D =         CAL$IX	EQU	($-TABLE$START)/2
 069C 8503      	DW	CAL
 069E 8603      	DW	CAL1
                
 000F =         OPR$IX	EQU	($-TABLE$START)/2
 06A0 0701      	DW	OPR00$00
 06A2 1D01      	DW	OPR00$01
 06A4 2901      	DW	OPR00$02
 06A6 2F01      	DW	OPR00$03
                
 06A8 3D01      	DW	OPR00$04
 06AA 5201      	DW	OPR00$05
 06AC 5D01      	DW	OPR00$06
 06AE 6601      	DW	OPR00$07
                
 06B0 7201      	DW	OPR00$08
 06B2 7701      	DW	OPR00$09
 06B4 7B01      	DW	OPR00$0A
 06B6 8101      	DW	OPR00$0B
                
 06B8 8701      	DW	OPR00$0C
 06BA 8D01      	DW	OPR00$0D
 06BC 9301      	DW	OPR00$0E
 06BE 9F01      	DW	OPR00$0F
                
 06C0 AB01      	DW	OPR00$10
 06C2 B401      	DW	OPR00$11
 06C4 C701      	DW	OPR00$12
 06C6 E101      	DW	OPR00$13
                	
 06C8 EB01      	DW	OPR00$14
 06CA F501      	DW	OPR00$15
 06CC 0002      	DW	OPR00$16
 06CE 0E02      	DW	OPR00$17
                
 0027 =         SP$IX	EQU	($-TABLE$START)/2
 0000 =         SP$NOP	EQU	0
 0000 =         SP6	EQU	SP$NOP
 0000 =         SP7	EQU	SP$NOP
                
 06D0 2902      	DW	SP0
 06D2 3202      	DW	SP1
 06D4 3802      	DW	SP2
 06D6 9D02      	DW	SP3
                	
 06D8 D302      	DW	SP4
 06DA E602      	DW	SP5
 06DC 0000      	DW	SP6
 06DE 0000      	DW	SP7
                
 06E0 FC02      	DW	SP8
                TABLE$END:
 0000 =         RTS$NOP	EQU	0
 06E2 0000      	DW	LIT$IX
 06E4 0F00      	DW	OPR$IX
 06E6 0300      	DW	LOD$IX
 06E8 0800      	DW	STO$IX
 06EA 0D00      	DW	CAL$IX
 06EC 0100      	DW	INT$IX
 06EE 0000      	DW	RTS$NOP		; JMP IS TRANSLATED INTO A JMP
 06F0 0000      	DW	RTS$NOP		; JPC IS TRANSLATED DIRECTLY
 06F2 2700      	DW	SP$IX
                
 0700           	ORG	($+0FFH) AND 0FF00H
                
                ; AS A FURTHER REDUCTION OF MEMORY USAGE, THE INIT ROUTINE IS
                ; MOVED INTO THE STACK AREA, TO BE OVERWRITTEN BY THE STACK ONCE IT HAS
                ; DONE ITS JOB
                
                ; INITIALISATION
                ; INIT BASE POINTER (BB), TOP OF STACK (STACK2), STACK POINTER (DE), AND
                ; SAVE EXIT ADDRESS AS DYNAMIC LINK IN STACK FRAME OF MAIN PROGRAM
                
                ; 8080 STACK USAGE: 0 BYTES
                INIT$LEN:
 0700 2600      	DW	(INIT$END-INIT)
                INIT:				; INIT BASE POINTER
 0702 210006    	LXI	H,RTS$INFO	; ADDRESS OF FIRST WORD BEYOND PROGRAM
                				; TO BE FILLED IN BY P-CODE TRANSLATOR.
                				; THE VALUE USED HERE IS TO MAKE SURE
                				; WHEN NO TRANSLATED P-CODE IS FILLED
                				; IN THE INIT ROUTINE DOESN'T CLOBBER
                				; IMPORTANT MEMORY LOACATIONS.
 0705 23        	INX	H		; POINT TO LOW ORDER BYTE
 0706 220301    	SHLD	BB		; SAVE AS BASE POINTER
 0709 2B        	DCX	H		; POINT BELOW STACK
 070A 2B        	DCX	H
 070B EB        	XCHG			; STACK POINTER TO DE
 070C 3A0700    	LDA	B$TOPRAM	; GET TOP OF TPA
 070F 3D        	DCR	A		; BACK OFF ONE PAGE
 0710 2F        	CMA
 0711 67        	MOV	H,A		; ...TO H
 0712 2E01      	MVI	L,001H		; FORM COMPLEMENT OF ADDRESS
 0714 220501    	SHLD	STACK2		; SAVE TOP OF STACK
 0717 210500    	LXI	H,5
 071A 19        	DAD	D		; HL POINT TO DYNAMIC LINK OF MAIN
                				;                                PROGRAM
 071B 011605    	LXI	B,EXIT		; GET EXIT ADDRESS
 071E 70        	MOV	M,B		; SAVE EXIT ADDRESS AS DYNAMIC LINK
 071F 23        	INX	H
 0720 71        	MOV	M,C
 0721 217E05    	LXI	H,PROGB-1	; INIT 8080 STACK
 0724 F9        	SPHL
 0725 C37F05    	JMP	PROGB		; DONE, START PROGRAM
                INIT$END:
                
 0728           	END 	0100H
